---
// Shared document shell. Each page imports its own fonts and stylesheets,
// so the concept demos never load the main site's fonts (and vice versa).
import { site } from '../data/site';
import { getLang, stripLang, localePath, withBase, BASE } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  /** Path to the Open Graph image inside /public. */
  ogImage?: string;
  noindex?: boolean;
  themeColor?: string;
}

const lang = getLang(Astro.url);
const t = ui[lang];
const {
  title = t.meta.title,
  description = t.meta.description,
  ogImage = t.meta.ogImage,
  noindex = false,
  themeColor = '#f4f0e8',
} = Astro.props;

const basePath = stripLang(Astro.url.pathname);
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const ogImageUrl = abs(withBase(ogImage));
const canonical = Astro.site ? abs(Astro.url.pathname) : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline define:vars={{ base: BASE }}>
      // Language: an explicit choice (saved by the EN/HU switch) wins; otherwise a browser whose
      // main language is Hungarian is sent from the English page to its Hungarian twin.
      var saved = null;
      try { saved = localStorage.getItem('lang'); } catch (e) {}
      var full = location.pathname;
      var path = base && full.indexOf(base) === 0 ? full.slice(base.length) || '/' : full;
      var onHu = path === '/hu' || path.indexOf('/hu/') === 0;
      var browser = ((navigator.languages && navigator.languages[0]) || navigator.language || '').toLowerCase();
      var want = saved || (browser.indexOf('hu') === 0 ? 'hu' : null);
      var rest = location.search + location.hash;
      if (want === 'hu' && !onHu) location.replace(base + '/hu' + path + rest);
      else if (saved === 'en' && onHu) location.replace(base + (path.replace(/^\/hu/, '') || '/') + rest);
      document.documentElement.classList.add('js');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    {
      Astro.site && (
        <>
          <link rel="alternate" hreflang="en" href={abs(localePath('en', basePath))} />
          <link rel="alternate" hreflang="hu" href={abs(localePath('hu', basePath))} />
          <link rel="alternate" hreflang="x-default" href={abs(localePath('en', basePath))} />
        </>
      )
    }
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={lang === 'hu' ? 'hu_HU' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'hu' ? 'en_GB' : 'hu_HU'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
