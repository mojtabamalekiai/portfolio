---
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '@fontsource-variable/karla';
import '../styles/concept-base.css';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ConceptBar from '../components/ConceptBar.astro';
import ActionBar from '../components/concept/ActionBar.astro';
import OpenHours from '../components/concept/OpenHours.astro';
import Icon from '../components/Icon.astro';
import { getLang, localePath } from '../i18n';
import hero from '../assets/photos/pipacs-hero.jpg';
import mass from '../assets/photos/pipacs-mass.jpg';
import shop from '../assets/photos/pipacs-shop.jpg';
import white from '../assets/photos/pipacs-white.jpg';
import sun from '../assets/photos/pipacs-sun.jpg';

const lang = getLang(Astro.url);
const hours: ([string, string] | null)[] = [
  ['08:00', '18:00'],
  ['08:00', '18:00'],
  ['08:00', '18:00'],
  ['08:00', '18:00'],
  ['08:00', '18:00'],
  ['08:00', '14:00'],
  ['09:00', '12:00'],
];

const copy = {
  en: {
    title: 'Pipacs Flower Shop (sample website by Mojtaba Maleki)',
    description: 'A sample website for a made-up flower shop with simple bouquet ordering, designed and built by Mojtaba Maleki.',
    tagline: 'flower shop',
    nav: ['Bouquets', 'Delivery', 'Find us'],
    order: 'Order flowers',
    h1: ['Say it', 'with flowers.'],
    lede: 'Hand-tied bouquets for every moment. Order by 2 pm and we deliver today.',
    choose: 'Choose a bouquet',
    call: 'Call us',
    heroAlt: 'A hand holding a lush bouquet of peach roses, ranunculus and lilac flowers against a dark background',
    shopTitle: 'Our bouquets',
    shopNote: 'Pick a size. The price updates straight away.',
    sizes: ['Small', 'Medium', 'Large'],
    sizeLabel: 'Size',
    orderThis: 'Order this bouquet',
    bouquets: [
      { name: 'Summer Joy', note: 'Bright, cheerful and full of sunflowers.', prices: ['6 900 Ft', '9 900 Ft', '14 900 Ft'], img: 'sun', alt: 'A hand-tied bouquet with a sunflower and wild flowers wrapped in brown paper' },
      { name: 'Wild Garden', note: 'Roses, ranunculus and lilac in soft colours.', prices: ['8 900 Ft', '12 900 Ft', '18 900 Ft'], img: 'hero', alt: 'A colourful bouquet of roses, ranunculus and lilac' },
      { name: 'Pure White', note: 'Elegant white roses for a calm, warm message.', prices: ['9 900 Ft', '13 900 Ft', '19 900 Ft'], img: 'white', alt: 'A bouquet of white roses and pale blue hydrangea wrapped in paper' },
    ],
    cardTitle: 'Not sure what to write on the card?',
    cardNote: 'Tap the occasion. We’ll suggest the words.',
    occasions: [
      ['Birthday', 'Happy birthday! May your year be as bright as these flowers.'],
      ['Thank you', 'Thank you for everything. These are for you, with love.'],
      ['Love', 'Every day with you is my favourite day.'],
      ['Get well', 'Thinking of you. Get well soon, we miss you.'],
      ['Sympathy', 'With deepest sympathy. You are in our thoughts.'],
    ],
    cardSay: 'You could write:',
    deliveryTitle: 'Simple delivery',
    delivery: [
      ['clock', 'Same day', 'Order by 2 pm, delivered the same afternoon.'],
      ['bag', 'Free in town', 'On orders over 10 000 Ft.'],
      ['check', 'Pay at the door', 'Card or cash on delivery.'],
    ],
    massAlt: 'A huge colourful bunch of ranunculus, anemones and roses',
    shopAlt: 'The front of a small flower shop with buckets of irises and daffodils by the door',
    visitTitle: 'Visit the shop',
    address: ['Virág utca 5.', 'On the corner by the church'],
    directions: 'Directions',
    actions: ['Call', 'Order', 'Map'],
    footer: ['Pipacs is a made-up business. This sample website was designed and built by', 'Photos: Unsplash.'],
  },
  hu: {
    title: 'Pipacs Virágbolt (Mojtaba Maleki mintaoldala)',
    description: 'Mintaoldal egy kitalált virágboltnak egyszerű csokorrendeléssel. Tervezte és készítette: Mojtaba Maleki.',
    tagline: 'virágbolt',
    nav: ['Csokrok', 'Kiszállítás', 'Elérhetőség'],
    order: 'Virágot rendelek',
    h1: ['Mondd el', 'virággal.'],
    lede: 'Kézzel kötött csokrok minden alkalomra. 14 óráig rendelj, és még ma kiszállítjuk.',
    choose: 'Válassz csokrot',
    call: 'Hívj minket',
    heroAlt: 'Egy kéz dús csokrot tart barackszínű rózsákkal, boglárkákkal és lila virágokkal, sötét háttér előtt',
    shopTitle: 'Csokraink',
    shopNote: 'Válassz méretet. Az ár azonnal frissül.',
    sizes: ['Kicsi', 'Közepes', 'Nagy'],
    sizeLabel: 'Méret',
    orderThis: 'Ezt a csokrot kérem',
    bouquets: [
      { name: 'Nyári öröm', note: 'Vidám, színes, tele napraforgóval.', prices: ['6 900 Ft', '9 900 Ft', '14 900 Ft'], img: 'sun', alt: 'Kézzel kötött csokor napraforgóval és mezei virágokkal barna papírban' },
      { name: 'Vadkert', note: 'Rózsa, boglárka és orgona lágy színekben.', prices: ['8 900 Ft', '12 900 Ft', '18 900 Ft'], img: 'hero', alt: 'Színes csokor rózsával, boglárkával és orgonával' },
      { name: 'Hófehér', note: 'Elegáns fehér rózsák egy nyugodt, meleg üzenethez.', prices: ['9 900 Ft', '13 900 Ft', '19 900 Ft'], img: 'white', alt: 'Fehér rózsákból és halványkék hortenziából kötött csokor papírban' },
    ],
    cardTitle: 'Nem tudod, mit írj a kártyára?',
    cardNote: 'Koppints az alkalomra, és mi javaslunk szöveget.',
    occasions: [
      ['Születésnap', 'Boldog születésnapot! Legyen az éved olyan ragyogó, mint ezek a virágok.'],
      ['Köszönöm', 'Köszönök mindent. Ezek neked szólnak, szeretettel.'],
      ['Szerelem', 'Minden nap veled a kedvenc napom.'],
      ['Jobbulást', 'Gondolunk rád. Gyógyulj meg hamar, hiányzol.'],
      ['Részvét', 'Őszinte részvétünk. Gondolatban veletek vagyunk.'],
    ],
    cardSay: 'Ezt írhatod:',
    deliveryTitle: 'Egyszerű kiszállítás',
    delivery: [
      ['clock', 'Még aznap', '14 óráig leadott rendelés, délután kiszállítva.'],
      ['bag', 'Ingyenes a városban', '10 000 Ft feletti rendelésnél.'],
      ['check', 'Fizetés átvételkor', 'Kártyával vagy készpénzzel.'],
    ],
    massAlt: 'Hatalmas, színes csokor boglárkából, szellőrózsából és rózsából',
    shopAlt: 'Egy kis virágbolt bejárata, az ajtó mellett vödrökben írisz és nárcisz',
    visitTitle: 'Gyere be a boltba',
    address: ['Virág utca 5.', 'A templom melletti saroknál'],
    directions: 'Útvonal',
    actions: ['Hívás', 'Rendelés', 'Térkép'],
    footer: ['A Pipacs kitalált vállalkozás. Ezt a mintaoldalt tervezte és készítette:', 'Fotók: Unsplash.'],
  },
}[lang];

const imgs = { hero, white, sun };
---

<Base title={copy.title} description={copy.description} noindex themeColor="#fff8f4">
  <ConceptBar business="Pipacs" />

  <div class="pp">
    <header class="top">
      <div class="wrap top-inner">
        <a href="#top" class="logo" aria-label="Pipacs">
          <span class="poppy" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span><em>Pipacs</em><small>{copy.tagline}</small></span>
        </a>
        <nav class="nav" aria-label="Pipacs">
          <a href="#shop">{copy.nav[0]}</a>
          <a href="#delivery">{copy.nav[1]}</a>
          <a href="#visit">{copy.nav[2]}</a>
        </nav>
        <a href="#shop" class="btn btn-small">{copy.order}</a>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-grid">
          <div class="hero-copy wrap-l">
            <OpenHours hours={hours} variant="badge" />
            <h1>{copy.h1[0]} <em>{copy.h1[1]}</em></h1>
            <p class="lede">{copy.lede}</p>
            <div class="actions">
              <a href="#shop" class="btn">{copy.choose}</a>
              <button type="button" class="btn btn-line" data-preview-kind="call"><Icon name="phone" />{copy.call}</button>
            </div>
          </div>
          <div class="hero-media">
            <Picture src={hero} alt={copy.heroAlt} formats={['avif', 'webp']} quality={68} widths={[480, 720, 1000, 1400]} sizes="(min-width: 60rem) 50vw, 100vw" loading="eager" fetchpriority="high" />
          </div>
        </div>
      </section>

      <section id="shop" class="shop" aria-labelledby="shop-title">
        <div class="wrap">
          <h2 id="shop-title">{copy.shopTitle}</h2>
          <p class="note">{copy.shopNote}</p>
          <ul class="bq-grid">
            {
              copy.bouquets.map((b, i) => (
                <li class="bq" data-bouquet>
                  <Picture src={imgs[b.img as keyof typeof imgs]} alt={b.alt} formats={['avif', 'webp']} quality={64} widths={[400, 640, 800]} sizes="(min-width: 60rem) 30vw, 92vw" />
                  <div class="bq-body">
                    <h3>{b.name}</h3>
                    <p>{b.note}</p>
                    <fieldset class="sizes">
                      <legend>{copy.sizeLabel}</legend>
                      {copy.sizes.map((sz, j) => (
                        <label>
                          <input type="radio" name={`size-${i}`} value={j} checked={j === 1} />
                          <span>
                            {sz}
                            <small class="size-price">{b.prices[j]}</small>
                          </span>
                        </label>
                      ))}
                    </fieldset>
                    <p class="bq-price" aria-live="polite" data-prices={JSON.stringify(b.prices)} hidden>
                      {b.prices[1]}
                    </p>
                    <button type="button" class="btn btn-wide" data-preview-kind="order">
                      <Icon name="bag" />
                      {copy.orderThis}
                    </button>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="card-help" aria-labelledby="card-title">
        <Picture src={mass} alt={copy.massAlt} formats={['avif', 'webp']} quality={60} widths={[640, 960, 1400]} sizes="100vw" class="card-bg" />
        <div class="wrap card-inner" data-occasions>
          <h2 id="card-title">{copy.cardTitle}</h2>
          <p class="note">{copy.cardNote}</p>
          <fieldset class="chips">
            <legend class="visually-hidden">{copy.cardTitle}</legend>
            {
              copy.occasions.map(([name], i) => (
                <label>
                  <input type="radio" name="occasion" value={i} checked={i === 0} />
                  <span>{name}</span>
                </label>
              ))
            }
          </fieldset>
          <div class="card-msgs">
            {
              copy.occasions.map(([name, msg], i) => (
                <figure class="card-msg" data-msg={i}>
                  <figcaption>
                    {copy.cardSay} <span class="visually-hidden">({name})</span>
                  </figcaption>
                  <blockquote>{msg}</blockquote>
                </figure>
              ))
            }
          </div>
        </div>
      </section>

      <section id="delivery" class="delivery" aria-labelledby="delivery-title">
        <div class="wrap">
          <h2 id="delivery-title">{copy.deliveryTitle}</h2>
          <ul>
            {
              copy.delivery.map(([icon, t, d]) => (
                <li>
                  <span class="d-icon">
                    <Icon name={icon as 'clock' | 'bag' | 'check'} />
                  </span>
                  <strong>{t}</strong>
                  <span>{d}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section id="visit" class="visit" aria-labelledby="visit-title">
        <div class="wrap visit-grid">
          <Picture src={shop} alt={copy.shopAlt} formats={['avif', 'webp']} quality={64} widths={[400, 640, 900]} sizes="(min-width: 60rem) 34vw, 92vw" class="shop-img" />
          <div>
            <h2 id="visit-title">{copy.visitTitle}</h2>
            <address><strong>{copy.address[0]}</strong>{copy.address[1]}</address>
            <div class="actions">
              <button type="button" class="btn" data-preview-kind="call"><Icon name="phone" />{copy.call}</button>
              <button type="button" class="btn btn-line" data-preview-kind="map"><Icon name="map" />{copy.directions}</button>
            </div>
            <div class="hours-card"><OpenHours hours={hours} /></div>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot wrap">
      <p class="logo-text"><em>Pipacs</em></p>
      <p>{copy.footer[0]}{' '}<a href={localePath(lang, '/')}>Mojtaba Maleki</a>. {copy.footer[1]}</p>
    </footer>
  </div>

  <ActionBar
    bg="#fffaf6"
    fg="#2a1614"
    primaryBg="#c42d20"
    primaryFg="#ffffff"
    actions={[
      { icon: 'phone', label: copy.actions[0], preview: 'call' },
      { icon: 'bag', label: copy.actions[1], href: '#shop' },
      { icon: 'map', label: copy.actions[2], preview: 'map' },
    ]}
  />
</Base>

<script>
  // Bouquet sizes: show one big live price instead of the per-size list.
  document.querySelectorAll<HTMLElement>('[data-bouquet]').forEach((card) => {
    const out = card.querySelector<HTMLElement>('.bq-price')!;
    const prices: string[] = JSON.parse(out.dataset.prices!);
    card.classList.add('is-js');
    out.hidden = false;
    card.addEventListener('change', () => {
      const j = Number(card.querySelector<HTMLInputElement>('input[type=radio]:checked')?.value ?? 1);
      out.textContent = prices[j];
    });
  });
  // Card message: show the suggestion for the chosen occasion.
  const occ = document.querySelector<HTMLElement>('[data-occasions]');
  if (occ) {
    const msgs = [...occ.querySelectorAll<HTMLElement>('[data-msg]')];
    const show = () => {
      const v = occ.querySelector<HTMLInputElement>('input[name=occasion]:checked')?.value ?? '0';
      msgs.forEach((m) => (m.hidden = m.dataset.msg !== v));
    };
    occ.addEventListener('change', show);
    show();
  }
</script>

<style>
  .pp {
    --poppy: #d93425;
    --poppy-ink: #a8211a;
    --btn: #c42d20;
    --blush: #fdece6;
    --cream: #fff8f4;
    --leaf: #1d4d33;
    --ink: #2a1614;
    --text: #4a3532;
    --rule: rgb(42 22 20 / 0.13);
    background: var(--cream);
    color: var(--text);
    font-family: 'Karla Variable', ui-sans-serif, system-ui, sans-serif;
    font-size: 1.15rem;
    line-height: 1.6;
  }
  .wrap {
    width: min(100% - 2.5rem, 72rem);
    margin-inline: auto;
  }
  h1,
  h2,
  h3,
  .logo,
  .logo-text {
    color: var(--ink);
    font-family: 'Playfair Display Variable', Georgia, serif;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  em {
    font-style: italic;
    font-weight: 500;
  }
  h2 {
    font-size: clamp(2.2rem, 1.6rem + 2.6vw, 3.6rem);
  }
  .note {
    margin-top: 0.6rem;
    color: var(--ink);
    font-weight: 600;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3.5rem;
    padding: 0.8rem 1.6rem;
    border: 2px solid var(--btn);
    border-radius: 999px;
    background: var(--btn);
    color: #fff;
    font-family: inherit;
    font-size: 1.0625rem;
    font-weight: 800;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.18s ease, transform 0.18s ease;
  }
  .btn:hover {
    background: var(--poppy-ink);
    border-color: var(--poppy-ink);
    transform: translateY(-1px);
  }
  .btn :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    stroke-width: 2.2;
  }
  .btn-line {
    background: transparent;
    color: var(--ink);
    border-color: var(--ink);
  }
  .btn-line:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  .btn-small {
    min-height: 2.9rem;
    padding: 0.5rem 1.15rem;
    font-size: 1rem;
  }
  .btn-wide {
    width: 100%;
  }
  .pp :focus-visible {
    outline: 3px solid var(--leaf);
    outline-offset: 3px;
  }

  /* Header */
  .top {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 248 244 / 0.96);
    border-bottom: 1px solid var(--rule);
  }
  .top-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 1.75rem;
    text-decoration: none;
    line-height: 1;
  }
  .logo small {
    display: block;
    margin-top: 0.15rem;
    color: var(--leaf);
    font-family: 'Karla Variable', sans-serif;
    font-size: 0.8rem;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .poppy {
    position: relative;
    width: 2.3rem;
    height: 2.3rem;
  }
  .poppy i {
    position: absolute;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 60% 40% 60% 40%;
    background: var(--poppy);
  }
  .poppy i:nth-child(1) {
    top: 0;
    left: 0.5rem;
  }
  .poppy i:nth-child(2) {
    top: 0.55rem;
    right: 0;
  }
  .poppy i:nth-child(3) {
    bottom: 0;
    left: 0.5rem;
  }
  .poppy i:nth-child(4) {
    top: 0.55rem;
    left: 0;
  }
  .poppy::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--ink);
    transform: translate(-50%, -50%);
  }
  .nav {
    display: none;
    gap: 2rem;
  }
  .nav a {
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }
  .nav a:hover {
    color: var(--poppy);
  }
  @media (min-width: 62rem) {
    .nav {
      display: flex;
    }
  }
  @media (max-width: 47.99rem) {
    .top .btn-small {
      display: none;
    }
  }

  /* Hero */
  .hero-grid {
    display: grid;
  }
  @media (min-width: 60rem) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
      min-height: 38rem;
    }
  }
  .hero-copy {
    align-self: center;
    padding: clamp(2rem, 6vw, 4rem) 1.25rem 2.5rem;
  }
  @media (min-width: 60rem) {
    .hero-copy {
      padding-left: max(1.25rem, calc((100vw - 72rem) / 2));
      padding-right: 3rem;
    }
  }
  .hero h1 {
    margin-top: 1.1rem;
    font-size: clamp(3.2rem, 1.6rem + 6.5vw, 6.8rem);
    line-height: 0.95;
  }
  .hero h1 em {
    display: block;
    color: var(--poppy);
  }
  .lede {
    max-width: 30rem;
    margin-top: 1.25rem;
    color: var(--ink);
    font-size: clamp(1.2rem, 1.1rem + 0.4vw, 1.4rem);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  @media (max-width: 30rem) {
    .actions .btn {
      width: 100%;
    }
  }
  .hero-media {
    position: relative;
    min-height: 22rem;
    background: #1a1310;
  }
  .hero-media :global(picture),
  .hero-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero-media :global(img) {
    object-fit: cover;
    aspect-ratio: 1;
  }
  @media (min-width: 60rem) {
    .hero-media :global(img) {
      aspect-ratio: auto;
    }
  }

  /* Shop */
  .shop {
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }
  .bq-grid {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 56rem) {
    .bq-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .bq {
    overflow: hidden;
    border-radius: 1.75rem;
    background: #fff;
    box-shadow: 0 0 0 1px var(--rule), 0 30px 50px -40px rgb(42 22 20 / 0.5);
  }
  .bq :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3.6;
    object-fit: cover;
  }
  .bq-body {
    display: grid;
    gap: 0.75rem;
    padding: 1.4rem 1.4rem 1.6rem;
  }
  .bq h3 {
    font-size: 1.9rem;
    font-style: italic;
    font-weight: 500;
  }
  .sizes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.45rem;
    margin: 0.25rem 0 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .sizes legend {
    margin-bottom: 0.4rem;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 800;
  }
  .sizes label {
    position: relative;
  }
  .sizes input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .sizes span {
    display: grid;
    place-items: center;
    gap: 0.1rem;
    min-height: 3.4rem;
    padding: 0.4rem 0.25rem;
    border: 2px solid var(--rule);
    border-radius: 0.9rem;
    color: var(--ink);
    font-weight: 800;
    text-align: center;
    line-height: 1.15;
  }
  .size-price {
    font-size: 0.85rem;
    font-weight: 600;
  }
  .bq.is-js .size-price {
    display: none;
  }
  .sizes input:hover + span {
    border-color: var(--ink);
  }
