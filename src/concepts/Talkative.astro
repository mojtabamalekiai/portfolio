---
import '@fontsource-variable/bricolage-grotesque';
import '../styles/concept-base.css';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ConceptBar from '../components/ConceptBar.astro';
import { getLang, localePath } from '../i18n';
import friends from '../assets/photos/talk-friends.jpg';
import laugh from '../assets/photos/talk-laugh.jpg';

const lang = getLang(Astro.url);

const copy = {
  en: {
    title: 'Talkative English Studio (design concept by Mojtaba Maleki)',
    description: 'A design concept for a fictional English school for adults, designed and built by Mojtaba Maleki.',
    nav: ['Courses', 'Your level', 'Prices'],
    trial: 'Free trial lesson',
    h1: ['Speak English with', 'confidence,', 'not perfection.'],
    lede: 'Relaxed lessons for adults in groups of up to six. Lots of talking, very little grammar homework.',
    ctaLevel: 'Find your level',
    ctaCourses: 'See courses',
    bubbles: ['How was your weekend?', 'Pretty good, thanks! I went hiking.'],
    sticker: ['Max', '6', 'people'],
    heroAlt: 'Two young women chatting and laughing at a café table',
    levelTitle: 'Where are you now?',
    levelIntro: 'Pick the sentence that sounds most like you.',
    levels: [
      { id: 'a', label: '“I know some words.”', code: 'A1–A2', course: 'Starter Talk', text: 'Everyday phrases, ordering food, small talk. You’ll be chatting in weeks, not years.' },
      { id: 'b', label: '“I get by, but I freeze.”', code: 'B1', course: 'Conversation Club', text: 'Lots of speaking practice so you stop translating in your head.' },
      { id: 'c', label: '“I’m comfortable, mostly.”', code: 'B2', course: 'Business English', text: 'Meetings, emails and presentations, with feedback on what really matters.' },
      { id: 'd', label: '“I want to sound natural.”', code: 'C1', course: 'Fluency & Exams', text: 'Idioms, nuance and exam strategy for Cambridge and IELTS.' },
    ],
    recommend: 'We recommend',
    coursesTitle: 'Courses',
    courses: [
      { name: 'Conversation Club', meta: 'Groups · 90 min · weekly', text: 'Real topics, real conversations. The quickest way to stop hesitating.', tone: 'lemon' },
      { name: 'Business English', meta: 'Groups or 1:1 · 60 min', text: 'Speak up in meetings and write emails without second-guessing.', tone: 'sky' },
      { name: 'Exam prep', meta: '1:1 · 60 min', text: 'Focused practice for Cambridge B2, C1 and IELTS.', tone: 'mint' },
    ],
    laughAlt: 'Two friends laughing over coffee at a café',
    howTitle: 'Online or in person',
    how: [['Pick a time', 'Morning, lunch or evening slots.'], ['Join your group', 'In our studio or on video.'], ['Just talk', 'Your teacher guides and corrects.']],
    pricesTitle: 'Clear prices',
    prices: [
      { name: 'Group lesson', price: '4 900 Ft', per: '/ 90 min' },
      { name: 'Private lesson', price: '9 900 Ft', per: '/ 60 min' },
      { name: 'Trial lesson', price: '0 Ft', per: '/ first time' },
    ],
    ctaBand: ['Your first lesson is on us.', 'Find your level and we’ll match you with a group.'],
    footer: ['Talkative is a fictional business. This website is a design concept by', 'Photography via Unsplash.'],
  },
  hu: {
    title: 'Talkative angol nyelviskola (Mojtaba Maleki koncepciója)',
    description: 'Egy kitalált, felnőtteknek szóló angol nyelviskola weboldal-koncepciója. Tervezte és készítette: Mojtaba Maleki.',
    nav: ['Kurzusok', 'Szintfelmérő', 'Árak'],
    trial: 'Ingyenes próbaóra',
    h1: ['Beszélj angolul', 'magabiztosan,', 'nem tökéletesen.'],
    lede: 'Laza órák felnőtteknek, legfeljebb hatfős csoportokban. Sok beszéd, nagyon kevés nyelvtani házi.',
    ctaLevel: 'Milyen szinten vagy?',
    ctaCourses: 'Kurzusok',
    bubbles: ['How was your weekend?', 'Pretty good, thanks! I went hiking.'],
    sticker: ['Max', '6', 'fő'],
    heroAlt: 'Két fiatal nő beszélget és nevet egy kávézó asztalánál',
    levelTitle: 'Hol tartasz most?',
    levelIntro: 'Válaszd azt a mondatot, ami a leginkább rád illik.',
    levels: [
      { id: 'a', label: '„Ismerek pár szót.”', code: 'A1–A2', course: 'Starter Talk', text: 'Hétköznapi kifejezések, rendelés, small talk. Hetek alatt beszélgetni fogsz, nem évek alatt.' },
      { id: 'b', label: '„Elboldogulok, de leblokkolok.”', code: 'B1', course: 'Conversation Club', text: 'Rengeteg beszédgyakorlás, hogy ne fordíts a fejedben.' },
      { id: 'c', label: '„Többnyire kényelmesen megy.”', code: 'B2', course: 'Business English', text: 'Megbeszélések, e-mailek és prezentációk, visszajelzéssel arra, ami igazán számít.' },
      { id: 'd', label: '„Természetesen akarok szólni.”', code: 'C1', course: 'Fluency & Exams', text: 'Idiómák, árnyalatok és vizsgastratégia Cambridge-hez és IELTS-hez.' },
    ],
    recommend: 'Ezt ajánljuk',
    coursesTitle: 'Kurzusok',
    courses: [
      { name: 'Conversation Club', meta: 'Csoportos · 90 perc · heti', text: 'Valódi témák, valódi beszélgetések. A leggyorsabb út, hogy ne akadj el.', tone: 'lemon' },
      { name: 'Business English', meta: 'Csoportos vagy egyéni · 60 perc', text: 'Szólalj meg bátran a megbeszéléseken, és írj e-mailt habozás nélkül.', tone: 'sky' },
      { name: 'Vizsgafelkészítés', meta: 'Egyéni · 60 perc', text: 'Célzott gyakorlás Cambridge B2, C1 és IELTS vizsgára.', tone: 'mint' },
    ],
    laughAlt: 'Két barát nevet egy kávé mellett egy kávézóban',
    howTitle: 'Online vagy személyesen',
    how: [['Válassz időpontot', 'Reggel, délben vagy este.'], ['Csatlakozz a csoporthoz', 'A stúdióban vagy videón.'], ['Csak beszélj', 'A tanárod vezet és javít.']],
    pricesTitle: 'Átlátható árak',
    prices: [
      { name: 'Csoportos óra', price: '4 900 Ft', per: '/ 90 perc' },
      { name: 'Egyéni óra', price: '9 900 Ft', per: '/ 60 perc' },
      { name: 'Próbaóra', price: '0 Ft', per: '/ első alkalom' },
    ],
    ctaBand: ['Az első óra ránk megy.', 'Mérd fel a szinted, és találunk neked egy csoportot.'],
    footer: ['A Talkative kitalált vállalkozás. Ez a weboldal egy koncepció, készítette:', 'Fotók: Unsplash.'],
  },
}[lang];
---

<Base title={copy.title} description={copy.description} noindex themeColor="#fff8ec">
  <ConceptBar business="Talkative" />

  <div class="tk">
    <header class="top">
      <div class="wrap top-inner">
        <a href="#top" class="logo" aria-label="Talkative"><span class="mark" aria-hidden="true"></span>talkative</a>
        <nav aria-label="Talkative">
          <ul>
            <li><a href="#courses">{copy.nav[0]}</a></li>
            <li><a href="#level">{copy.nav[1]}</a></li>
            <li><a href="#prices">{copy.nav[2]}</a></li>
          </ul>
        </nav>
        <a href="#level" class="btn btn-small">{copy.trial}</a>
      </div>
    </header>

    <main id="top">
      <section class="hero wrap">
        <div class="hero-copy">
          <h1>
            {copy.h1[0]} <mark>{copy.h1[1]}</mark>
            <span class="soft">{copy.h1[2]}</span>
          </h1>
          <p class="lede">{copy.lede}</p>
          <div class="actions">
            <a href="#level" class="btn">{copy.ctaLevel}</a>
            <a href="#courses" class="btn btn-outline">{copy.ctaCourses}</a>
          </div>
        </div>
        <div class="hero-media">
          <Picture src={friends} formats={['avif', 'webp']} quality={68} widths={[480, 720, 960, 1280]} sizes="(min-width: 60rem) 45vw, 92vw" alt={copy.heroAlt} loading="eager" fetchpriority="high" />
          <p class="bubble b1" aria-hidden="true" lang="en">{copy.bubbles[0]}</p>
          <p class="bubble b2" aria-hidden="true" lang="en">{copy.bubbles[1]}</p>
          <p class="sticker" aria-hidden="true"><span>{copy.sticker[0]}</span><strong>{copy.sticker[1]}</strong><span>{copy.sticker[2]}</span></p>
        </div>
      </section>

      <section id="level" class="level">
        <div class="wrap level-inner">
          <div>
            <h2>{copy.levelTitle}</h2>
            <p class="intro">{copy.levelIntro}</p>
          </div>
          <form class="picker" onsubmit="return false">
            <fieldset>
              <legend class="visually-hidden">{copy.levelTitle}</legend>
              {
                copy.levels.map((l, i) => (
                  <label class="option">
                    <input type="radio" name="level" value={l.id} checked={i === 1} />
                    <span>{l.label}</span>
                  </label>
                ))
              }
            </fieldset>
            <div class="results" aria-live="polite">
              {
                copy.levels.map((l) => (
                  <div class:list={['result', `r-${l.id}`]}>
                    <p class="rec">{copy.recommend}</p>
                    <p class="course">
                      {l.course} <span class="code">{l.code}</span>
                    </p>
                    <p>{l.text}</p>
                  </div>
                ))
              }
            </div>
          </form>
        </div>
      </section>

      <section id="courses" class="courses wrap" aria-labelledby="courses-title">
        <h2 id="courses-title">{copy.coursesTitle}</h2>
        <ul class="course-grid">
          {
            copy.courses.map((c) => (
              <li class={`tone-${c.tone}`}>
                <p class="cmeta">{c.meta}</p>
                <h3>{c.name}</h3>
                <p>{c.text}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="how wrap" aria-labelledby="how-title">
        <Picture src={laugh} formats={['avif', 'webp']} quality={68} widths={[480, 720, 960]} sizes="(min-width: 60rem) 40vw, 92vw" alt={copy.laughAlt} class="how-img" />
        <div>
          <h2 id="how-title">{copy.howTitle}</h2>
          <ol>
            {
              copy.how.map(([t, d], i) => (
                <li>
                  <span class="n">{i + 1}</span>
                  <span>
                    <strong>{t}</strong>
                    {d}
                  </span>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section id="prices" class="prices wrap" aria-labelledby="prices-title">
        <h2 id="prices-title">{copy.pricesTitle}</h2>
        <ul>
          {
            copy.prices.map((p) => (
              <li>
                <span class="pname">{p.name}</span>
                <span class="pprice">
                  {p.price} <small>{p.per}</small>
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="band">
        <div class="wrap band-inner">
          <div>
            <h2>{copy.ctaBand[0]}</h2>
            <p>{copy.ctaBand[1]}</p>
          </div>
          <a href="#level" class="btn btn-light">{copy.ctaLevel}</a>
        </div>
      </section>
    </main>

    <footer class="foot wrap">
      <p class="logo"><span class="mark" aria-hidden="true"></span>talkative</p>
      <p>
        {copy.footer[0]}{' '}
        <a href={localePath(lang, '/')}>Mojtaba Maleki</a>. {copy.footer[1]}
      </p>
    </footer>
  </div>
</Base>

<style>
  .tk {
    --cream: #fff8ec;
    --navy: #1c1f4a;
    --text: #44476b;
    --coral: #ff6a4d;
    --coral-ink: #c63f22;
    --lemon: #ffd84d;
    --sky: #bfe0ff;
    --mint: #c6efd6;
    background: var(--cream);
    color: var(--text);
    font-family: 'Bricolage Grotesque Variable', ui-sans-serif, system-ui, sans-serif;
    font-size: 1.0625rem;
  }
  .wrap {
    width: min(100% - clamp(2.5rem, 6vw, 5rem), 76rem);
    margin-inline: auto;
  }
  h1,
  h2,
  h3,
  .logo {
    color: var(--navy);
    font-weight: 750;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  h2 {
    font-size: clamp(2.4rem, 1.6rem + 3.4vw, 4.4rem);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 3.2rem;
    padding: 0.8rem 1.6rem;
    border: 2px solid var(--navy);
    border-radius: 999px;
    background: var(--navy);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 4px 4px 0 var(--coral);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--coral);
  }
  .btn:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--coral);
  }
  .btn-outline {
    background: transparent;
    color: var(--navy);
    box-shadow: 4px 4px 0 var(--lemon);
  }
  .btn-outline:hover {
    box-shadow: 6px 6px 0 var(--lemon);
  }
  .btn-small {
    min-height: 2.6rem;
    padding: 0.45rem 1.1rem;
    font-size: 0.92rem;
    box-shadow: 3px 3px 0 var(--coral);
  }
  .btn-light {
    background: #fff;
    color: var(--navy);
    box-shadow: 4px 4px 0 var(--navy);
  }
  .btn-light:hover {
    box-shadow: 6px 6px 0 var(--navy);
  }
  .tk :focus-visible {
    outline: 3px solid var(--coral);
    outline-offset: 3px;
  }

  /* Header */
  .top {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 248 236 / 0.95);
    border-bottom: 2px solid var(--navy);
  }
  .top-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.25rem;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.6rem;
    text-decoration: none;
  }
  .mark {
    position: relative;
    width: 1.6rem;
    height: 1.25rem;
    border-radius: 0.6rem;
    background: var(--coral);
  }
  .mark::after {
    content: '';
    position: absolute;
    left: 0.3rem;
    bottom: -0.35rem;
    border: 0.25rem solid transparent;
    border-top-color: var(--coral);
    border-left-color: var(--coral);
  }
  .top ul {
    display: flex;
    gap: 2rem;
    padding: 0;
    list-style: none;
  }
  .top nav a {
    color: var(--navy);
    font-weight: 600;
    text-decoration: none;
  }
  .top nav a:hover {
    text-decoration: underline wavy var(--coral);
    text-underline-offset: 0.3em;
  }
  @media (max-width: 46rem) {
    .top nav {
      display: none;
    }
  }

  /* Hero */
  .hero {
    display: grid;
    gap: clamp(3rem, 5vw, 4.5rem);
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 5.5rem);
  }
  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .hero h1 {
    font-size: clamp(2.3rem, 1.2rem + 5.5vw, 6rem);
  }
  mark {
    padding: 0 0.15em;
    border-radius: 0.2em;
    background: linear-gradient(transparent 55%, var(--lemon) 55%, var(--lemon) 92%, transparent 92%);
    color: inherit;
  }
  .soft {
    display: block;
    color: var(--coral-ink);
  }
  .lede {
    max-width: 30rem;
    margin-top: 1.5rem;
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.25rem;
  }
  .hero-media {
    position: relative;
    margin-inline: 0.5rem;
  }
  .hero-media :global(img) {
    width: 100%;
    aspect-ratio: 5 / 4.4;
    object-fit: cover;
    border: 2px solid var(--navy);
    border-radius: 2.5rem 2.5rem 2.5rem 0.6rem;
    box-shadow: 10px 10px 0 var(--sky);
  }
  .bubble {
    position: absolute;
    max-width: 15rem;
    padding: 0.7rem 1rem;
    border: 2px solid var(--navy);
    border-radius: 1.2rem;
    background: #fff;
    color: var(--navy);
    font-weight: 600;
    line-height: 1.3;
    box-shadow: 3px 3px 0 var(--navy);
  }
  .b1 {
    top: -1.25rem;
    left: -0.75rem;
    border-bottom-left-radius: 0.2rem;
    transform: rotate(-3deg);
  }
  .b2 {
    right: -0.75rem;
    bottom: 2.5rem;
    background: var(--lemon);
    border-bottom-right-radius: 0.2rem;
    transform: rotate(2deg);
  }
  .sticker {
    position: absolute;
    left: 1.25rem;
    bottom: -1.5rem;
    display: grid;
    place-items: center;
    width: 6.5rem;
    height: 6.5rem;
    border: 2px solid var(--navy);
    border-radius: 50%;
    background: var(--coral-ink);
    color: #fff;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    transform: rotate(-10deg);
  }
  .sticker strong {
    font-size: 2.2rem;
  }
  .sticker span {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  @media (prefers-reduced-motion: no-preference) {
    .b1 {
      animation: float 5s ease-in-out infinite;
    }
    .b2 {
      animation: float 5s ease-in-out 1.2s infinite;
    }
  }
  @keyframes float {
    50% {
      translate: 0 -6px;
    }
  }

  /* Level picker (pure CSS: :has) */
  .level {
    margin-top: 2rem;
    padding-block: clamp(4rem, 8vw, 6.5rem);
    background: var(--navy);
    color: #d6d8f0;
  }
  .level h2 {
    color: #fff;
  }
  .level-inner {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 60rem) {
    .level-inner {
      grid-template-columns: 0.8fr 1.4fr;
    }
  }
  .intro {
    margin-top: 1rem;
    font-size: 1.15rem;
  }
  .picker {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 46rem) {
    .picker {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  fieldset {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .option {
    position: relative;
  }
  .option input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .option span {
    display: block;
    padding: 0.95rem 1.2rem;
    border: 2px solid rgb(255 255 255 / 0.25);
    border-radius: 1rem;
    color: #fff;
    font-weight: 600;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }
  .option input:hover + span {
    border-color: #fff;
  }
  .option input:checked + span {
    border-color: var(--lemon);
    background: var(--lemon);
    color: var(--navy);
  }
  .option input:focus-visible + span {
    outline: 3px solid var(--coral);
    outline-offset: 2px;
  }
  .result {
    display: none;
    padding: 1.75rem;
    border-radius: 1.5rem;
    background: var(--cream);
    color: var(--text);
    box-shadow: 8px 8px 0 var(--coral);
  }
  .picker:has(input[value='a']:checked) .r-a,
  .picker:has(input[value='b']:checked) .r-b,
  .picker:has(input[value='c']:checked) .r-c,
  .picker:has(input[value='d']:checked) .r-d {
    display: block;
    animation: pop 0.3s ease;
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .rec {
    color: var(--coral-ink);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .course {
    margin-block: 0.4rem 0.75rem;
    color: var(--navy);
    font-size: 2rem;
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .code {
    display: inline-block;
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    background: var(--navy);
    color: #fff;
    font-size: 0.85rem;
    letter-spacing: 0;
    vertical-align: middle;
  }

  /* Courses */
  .courses {
    padding-block: clamp(4rem, 8vw, 7rem);
  }
  .course-grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 2.5rem;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 52rem) {
    .course-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .course-grid li {
    padding: 2rem 1.75rem 2.25rem;
    border: 2px solid var(--navy);
    border-radius: 1.75rem;
    color: var(--navy);
    transition: transform 0.2s ease;
  }
  .course-grid li:hover {
    transform: rotate(-1deg) translateY(-3px);
  }
  .tone-lemon {
    background: var(--lemon);
  }
  .tone-sky {
    background: var(--sky);
  }
  .tone-mint {
    background: var(--mint);
  }
  .cmeta {
    font-size: 0.85rem;
    font-weight: 700;
  }
  .course-grid h3 {
    margin-block: 1.75rem 0.75rem;
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2rem);
    hyphens: auto;
    overflow-wrap: break-word;
  }

  /* How */
  .how {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }
  @media (min-width: 60rem) {
    .how {
      grid-template-columns: 1fr 1fr;
    }
  }
  .how :global(.how-img) {
    width: 100%;
    aspect-ratio: 16 / 11;
    object-fit: cover;
    border: 2px solid var(--navy);
