---
import '@fontsource/dm-serif-display/400.css';
import '@fontsource/dm-serif-display/400-italic.css';
import '@fontsource-variable/nunito';
import '../styles/concept-base.css';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ConceptBar from '../components/ConceptBar.astro';
import ActionBar from '../components/concept/ActionBar.astro';
import OpenHours from '../components/concept/OpenHours.astro';
import TextSize from '../components/concept/TextSize.astro';
import Icon from '../components/Icon.astro';
import { getLang, localePath } from '../i18n';
import soup from '../assets/photos/nagyi-soup.jpg';
import cabbage from '../assets/photos/nagyi-cabbage.jpg';
import schnitzel from '../assets/photos/nagyi-schnitzel.jpg';
import stew from '../assets/photos/nagyi-stew.jpg';

const lang = getLang(Astro.url);
const hours: ([string, string] | null)[] = [
  ['11:00', '20:00'],
  ['11:00', '20:00'],
  ['11:00', '20:00'],
  ['11:00', '20:00'],
  ['11:00', '21:00'],
  ['11:00', '21:00'],
  ['11:00', '16:00'],
];

type DayMenu = { soup: string; main: string; sweet: string };
const copy = {
  en: {
    title: 'Nagyi Konyhája — family restaurant (sample website by Mojtaba Maleki)',
    description: 'A sample website for a made-up family restaurant with a daily lunch menu, designed and built by Mojtaba Maleki.',
    tagline: 'family restaurant',
    nav: ['Daily menu', 'Favourites', 'Find us'],
    call: 'Call us',
    h1: ['Home cooking,', 'just like Grandma’s.'],
    lede: 'Fresh soup, a hearty main and something sweet. Every day from 11:00.',
    ctaMenu: 'See today’s menu',
    priceSticker: ['Daily menu', '2 490 Ft'],
    soupAlt: 'A big pot of soup simmering over an open fire outdoors',
    menuTitle: 'This week’s daily menu',
    menuNote: 'Soup + main + dessert for 2 490 Ft. Takeaway box +200 Ft.',
    weekend: 'At the weekend we cook from the full menu. Here is Monday’s menu.',
    days: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    short: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'],
    courses: ['Soup', 'Main course', 'Dessert'],
    today: 'Today',
    week: [
      { soup: 'Goulash soup', main: 'Breaded chicken breast with mashed potatoes', sweet: 'Cottage-cheese pancakes' },
      { soup: 'Chicken broth with thin noodles', main: 'Chicken paprikash with dumplings', sweet: 'Apple pie' },
      { soup: 'Green pea soup', main: 'Stuffed cabbage with sour cream', sweet: 'Poppy-seed bread pudding' },
      { soup: 'Cream of mushroom soup', main: 'Pork stew with nokedli', sweet: 'Somlói trifle' },
      { soup: 'Fisherman’s soup', main: 'Fried carp with parsley potatoes', sweet: 'Cottage-cheese dumplings' },
    ] as DayMenu[],
    favTitle: 'Everyone’s favourites',
    favs: [
      { name: 'Stuffed cabbage', note: 'Slow-cooked for hours, with plenty of sour cream.', price: '3 290 Ft', img: 'cabbage', alt: 'Stuffed cabbage rolls with sour cream on a white plate' },
      { name: 'Breaded schnitzel', note: 'Crispy, golden, with creamy mashed potatoes.', price: '3 490 Ft', img: 'schnitzel', alt: 'Golden breaded schnitzel with mashed potatoes and spring onion' },
      { name: 'Pork stew', note: 'Paprika, onions and patience. Served with nokedli.', price: '3 190 Ft', img: 'stew', alt: 'Hearty paprika stew simmering in a large pot' },
    ],
    storyTitle: 'Three generations, one kitchen.',
    story: 'Erzsi néni opened our doors in 1998 with her own recipes. Today her granddaughter cooks them, exactly the same way.',
    quote: '“If our guests leave full and happy, so are we.”',
    quoteBy: 'Erzsi néni, founder',
    visitTitle: 'Come and eat with us',
    address: ['Piac tér 3.', 'Opposite the old market hall'],
    perks: ['Free parking behind the building', 'Step-free entrance', 'Card & cash'],
    directions: 'Directions',
    actions: ['Call', 'Menu', 'Map'],
    footer: ['Nagyi Konyhája is a made-up business. This sample website was designed and built by', 'Photos: Unsplash.'],
  },
  hu: {
    title: 'Nagyi Konyhája — családi étterem (Mojtaba Maleki mintaoldala)',
    description: 'Mintaoldal egy kitalált családi étteremnek napi menüvel. Tervezte és készítette: Mojtaba Maleki.',
    tagline: 'családi étterem',
    nav: ['Napi menü', 'Kedvencek', 'Elérhetőség'],
    call: 'Hívj minket',
    h1: ['Házias ízek,', 'ahogy a nagyi főzte.'],
    lede: 'Friss leves, kiadós főétel és egy kis édesség. Minden nap 11:00-tól.',
    ctaMenu: 'A mai menü',
    priceSticker: ['Napi menü', '2 490 Ft'],
    soupAlt: 'Egy nagy bogrács leves rotyog a szabadtéri tűz fölött',
    menuTitle: 'A heti napi menü',
    menuNote: 'Leves + főétel + desszert 2 490 Ft. Elviteles doboz +200 Ft.',
    weekend: 'Hétvégén a teljes étlapról főzünk. Itt a hétfői menü.',
    days: ['Hétfő', 'Kedd', 'Szerda', 'Csütörtök', 'Péntek'],
    short: ['H', 'K', 'Sze', 'Cs', 'P'],
    courses: ['Leves', 'Főétel', 'Desszert'],
    today: 'Ma',
    week: [
      { soup: 'Gulyásleves', main: 'Rántott csirkemell burgonyapürével', sweet: 'Túrós palacsinta' },
      { soup: 'Húsleves cérnametélttel', main: 'Paprikás csirke galuskával', sweet: 'Almás pite' },
      { soup: 'Zöldborsóleves', main: 'Töltött káposzta tejföllel', sweet: 'Mákos guba' },
      { soup: 'Gombakrémleves', main: 'Sertéspörkölt nokedlivel', sweet: 'Somlói galuska' },
      { soup: 'Halászlé', main: 'Rántott ponty petrezselymes burgonyával', sweet: 'Túrógombóc' },
    ] as DayMenu[],
    favTitle: 'Mindenki kedvencei',
    favs: [
      { name: 'Töltött káposzta', note: 'Órákig főzzük, bőven tejföllel.', price: '3 290 Ft', img: 'cabbage', alt: 'Töltött káposzta tejföllel egy fehér tányéron' },
      { name: 'Rántott szelet', note: 'Ropogós, aranybarna, krémes burgonyapürével.', price: '3 490 Ft', img: 'schnitzel', alt: 'Aranybarna rántott szelet burgonyapürével és újhagymával' },
      { name: 'Sertéspörkölt', note: 'Paprika, hagyma és türelem. Nokedlivel tálaljuk.', price: '3 190 Ft', img: 'stew', alt: 'Kiadós paprikás pörkölt rotyog egy nagy edényben' },
    ],
    storyTitle: 'Három generáció, egy konyha.',
    story: 'Erzsi néni 1998-ban nyitotta meg az éttermet a saját receptjeivel. Ma az unokája főzi őket, pontosan ugyanúgy.',
    quote: '„Ha a vendég jóllakott és boldog, akkor mi is azok vagyunk.”',
    quoteBy: 'Erzsi néni, alapító',
    visitTitle: 'Gyere el, egyél velünk',
    address: ['Piac tér 3.', 'A régi vásárcsarnokkal szemben'],
    perks: ['Ingyenes parkoló az épület mögött', 'Akadálymentes bejárat', 'Kártya és készpénz'],
    directions: 'Útvonal',
    actions: ['Hívás', 'Menü', 'Térkép'],
    footer: ['A Nagyi Konyhája kitalált vállalkozás. Ezt a mintaoldalt tervezte és készítette:', 'Fotók: Unsplash.'],
  },
}[lang];

const favImg = { cabbage, schnitzel, stew };

// Hungarian folk-embroidery strip (tulip, leaves and dots), used as a repeating border.
const folkSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="72" height="34" viewBox="0 0 72 34"><g><path d="M36 3c-5 4-7.5 9-5.5 14.5 1.2 3.3 3.3 5 5.5 5s4.3-1.7 5.5-5C43.5 12 41 7 36 3z" fill="#b3261e"/><path d="M36 9c-2 3-2.4 6.8 0 10.5 2.4-3.7 2-7.5 0-10.5z" fill="#e2a72e"/><path d="M36 22v9" stroke="#2f6b3a" stroke-width="2"/><path d="M36 31c-6.5 0-10.5-3-12.5-7.5 5.5.8 9.8 3.2 12.5 7.5zM36 31c6.5 0 10.5-3 12.5-7.5-5.5.8-9.8 3.2-12.5 7.5z" fill="#2f6b3a"/><circle cx="9" cy="17" r="3.6" fill="#b3261e"/><circle cx="63" cy="17" r="3.6" fill="#b3261e"/><circle cx="19" cy="11" r="2" fill="#e2a72e"/><circle cx="53" cy="11" r="2" fill="#e2a72e"/><circle cx="19" cy="24" r="2" fill="#2f6b3a"/><circle cx="53" cy="24" r="2" fill="#2f6b3a"/></g></svg>`;
const folk = `url("data:image/svg+xml,${encodeURIComponent(folkSvg)}")`;
---

<Base title={copy.title} description={copy.description} noindex themeColor="#fbf3e4">
  <ConceptBar business="Nagyi Konyhája" />

  <div class="ng" style={`--folk:${folk}`}>
    <header class="top">
      <div class="wrap top-inner">
        <a href="#top" class="logo" aria-label="Nagyi Konyhája">
          <span class="logo-mark" aria-hidden="true"></span>
          <span>Nagyi Konyhája<small>{copy.tagline}</small></span>
        </a>
        <nav class="nav" aria-label="Nagyi Konyhája">
          <a href="#napi">{copy.nav[0]}</a>
          <a href="#kedvencek">{copy.nav[1]}</a>
          <a href="#elerhetoseg">{copy.nav[2]}</a>
        </nav>
        <div class="top-tools">
          <TextSize class="ts-ng" />
          <button type="button" class="btn btn-small" data-preview-kind="call">
            <Icon name="phone" />
            <span>{copy.call}</span>
          </button>
        </div>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <OpenHours hours={hours} variant="badge" class="hero-oh" />
            <h1>{copy.h1[0]} <em>{copy.h1[1]}</em></h1>
            <p class="lede">{copy.lede}</p>
            <div class="actions">
              <a href="#napi" class="btn">{copy.ctaMenu}</a>
              <button type="button" class="btn btn-line" data-preview-kind="call">
                <Icon name="phone" />
                {copy.call}
              </button>
            </div>
          </div>
          <div class="hero-media">
            <Picture src={soup} alt={copy.soupAlt} formats={['avif', 'webp']} quality={66} widths={[400, 640, 900, 1200]} sizes="(min-width: 60rem) 42vw, 92vw" loading="eager" fetchpriority="high" />
            <p class="sticker" aria-hidden="true"><span>{copy.priceSticker[0]}</span><strong>{copy.priceSticker[1]}</strong></p>
          </div>
        </div>
      </section>

      <div class="folk-strip" aria-hidden="true"></div>

      <section id="napi" class="menu" aria-labelledby="menu-title">
        <div class="wrap">
          <h2 id="menu-title">{copy.menuTitle}</h2>
          <p class="menu-note">{copy.menuNote}</p>
          <div class="day-tabs" role="tablist" aria-labelledby="menu-title" data-days hidden>
            {
              copy.days.map((d, i) => (
                <button type="button" role="tab" id={`ng-tab-${i}`} aria-controls={`ng-day-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                  <span class="d-long">{d}</span>
                  <span class="d-short" aria-hidden="true">{copy.short[i]}</span>
                  <span class="today-tag" hidden>{copy.today}</span>
                </button>
              ))
            }
          </div>
          <p class="weekend" hidden data-weekend>{copy.weekend}</p>
          <div class="days">
            {
              copy.week.map((m, i) => (
                <article class="day-card" role="tabpanel" id={`ng-day-${i}`} aria-labelledby={`ng-tab-${i}`} data-day={i}>
                  <h3 class="day-name">{copy.days[i]}</h3>
                  <ol class="courses">
                    {[m.soup, m.main, m.sweet].map((dish, c) => (
                      <li>
                        <span class="course-label">{copy.courses[c]}</span>
                        <span class="dish">{dish}</span>
                      </li>
                    ))}
                  </ol>
                  <p class="day-price">2 490 Ft</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="kedvencek" class="favs" aria-labelledby="fav-title">
        <div class="wrap">
          <h2 id="fav-title">{copy.favTitle}</h2>
          <ul class="fav-grid">
            {
              copy.favs.map((f) => (
                <li>
                  <Picture src={favImg[f.img as keyof typeof favImg]} alt={f.alt} formats={['avif', 'webp']} quality={64} widths={[400, 640, 800]} sizes="(min-width: 60rem) 30vw, 92vw" />
                  <div class="fav-body">
                    <h3>{f.name}</h3>
                    <p>{f.note}</p>
                    <p class="fav-price">{f.price}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="story">
        <div class="wrap story-inner">
          <div>
            <h2>{copy.storyTitle}</h2>
            <p>{copy.story}</p>
          </div>
          <blockquote>
            <p>{copy.quote}</p>
            <footer>{copy.quoteBy}</footer>
          </blockquote>
        </div>
      </section>

      <section id="elerhetoseg" class="visit" aria-labelledby="visit-title">
        <div class="wrap visit-grid">
          <div>
            <h2 id="visit-title">{copy.visitTitle}</h2>
            <address>
              <strong>{copy.address[0]}</strong>
              {copy.address[1]}
            </address>
            <ul class="perks">
              {
                copy.perks.map((p) => (
                  <li>
                    <Icon name="check" />
                    {p}
                  </li>
                ))
              }
            </ul>
            <div class="actions">
              <button type="button" class="btn" data-preview-kind="call">
                <Icon name="phone" />
                {copy.call}
              </button>
              <button type="button" class="btn btn-line" data-preview-kind="map">
                <Icon name="map" />
                {copy.directions}
              </button>
            </div>
          </div>
          <div class="hours-card">
            <OpenHours hours={hours} />
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-inner">
        <p class="logo">
          <span class="logo-mark" aria-hidden="true"></span>
          <span>Nagyi Konyhája</span>
        </p>
        <p>
          {copy.footer[0]}{' '}
          <a href={localePath(lang, '/')}>Mojtaba Maleki</a>. {copy.footer[1]}
        </p>
      </div>
    </footer>
  </div>

  <ActionBar
    bg="#fffaf1"
    fg="#2b1d16"
    primaryBg="#b3261e"
    primaryFg="#ffffff"
    actions={[
      { icon: 'phone', label: copy.actions[0], preview: 'call' },
      { icon: 'calendar', label: copy.actions[1], href: '#napi' },
      { icon: 'map', label: copy.actions[2], preview: 'map' },
    ]}
  />
</Base>

<script>
  // Daily menu: open on today's tab (weekend → Monday with a note).
  const tabs = document.querySelector<HTMLElement>('[data-days]');
  if (tabs) {
    const btns = [...tabs.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = [...document.querySelectorAll<HTMLElement>('[data-day]')];
    const select = (i: number, focus = false) => {
      btns.forEach((b, j) => {
        b.setAttribute('aria-selected', String(i === j));
        b.tabIndex = i === j ? 0 : -1;
      });
      panels.forEach((p, j) => p.toggleAttribute('data-active', i === j));
      if (focus) btns[i].focus();
    };
    const dow = (new Date().getDay() + 6) % 7; // Monday = 0
    const start = dow < 5 ? dow : 0;
    if (dow < 5) btns[dow].querySelector<HTMLElement>('.today-tag')!.hidden = false;
    else document.querySelector<HTMLElement>('[data-weekend]')!.hidden = false;
    tabs.hidden = false;
    document.documentElement.classList.add('ng-tabs');
    select(start);
    btns.forEach((b, i) => {
      b.addEventListener('click', () => select(i));
      b.addEventListener('keydown', (e) => {
        const n = btns.length;
        if (e.key === 'ArrowRight') select((i + 1) % n, true);
        else if (e.key === 'ArrowLeft') select((i - 1 + n) % n, true);
        else return;
        e.preventDefault();
      });
    });
  }
</script>

<style>
  .ng {
    --paprika: #b3261e;
    --paprika-ink: #8e1c16;
    --cream: #fbf3e4;
    --paper: #fffaf1;
    --ink: #2b1d16;
    --text: #463730;
    --green: #2f6b3a;
    --gold: #e2a72e;
    --rule: rgb(43 29 22 / 0.14);
    background: var(--cream);
    color: var(--text);
    font-family: 'Nunito Variable', ui-sans-serif, system-ui, sans-serif;
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .wrap {
    width: min(100% - 2.5rem, 72rem);
    margin-inline: auto;
  }
  h1,
  h2,
  h3,
  .logo {
    color: var(--ink);
    font-family: 'DM Serif Display', Georgia, serif;
    font-weight: 400;
    line-height: 1.05;
  }
  h2 {
    font-size: clamp(2.2rem, 1.6rem + 2.6vw, 3.6rem);
  }
  em {
    color: var(--paprika);
    font-style: italic;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3.5rem;
    padding: 0.8rem 1.6rem;
    border: 2px solid var(--paprika);
    border-radius: 999px;
    background: var(--paprika);
    color: #fff;
    font-weight: 800;
    font-size: 1.0625rem;
    line-height: 1.1;
    font-family: inherit;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.18s ease, transform 0.18s ease;
  }
  .btn:hover {
    background: var(--paprika-ink);
    border-color: var(--paprika-ink);
    transform: translateY(-1px);
  }
  .btn :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    stroke-width: 2;
  }
  .btn-line {
    background: transparent;
    color: var(--ink);
    border-color: var(--ink);
  }
  .btn-line:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .btn-small {
    min-height: 2.9rem;
    padding: 0.5rem 1.1rem;
    font-size: 1rem;
  }
  .ng :focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 3px;
  }

  /* Header */
  .top {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(251 243 228 / 0.96);
    border-bottom: 1px solid var(--rule);
  }
  .top-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.55rem;
    text-decoration: none;
  }
  .logo small {
    display: block;
    margin-top: 0.15rem;
    color: var(--green);
    font-family: 'Nunito Variable', sans-serif;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .logo-mark {
    flex: none;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: var(--folk) center / 3.1rem no-repeat, var(--paper);
    box-shadow: inset 0 0 0 2px var(--paprika);
  }
  .nav {
    display: none;
    gap: 2rem;
  }
  .nav a {
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }
  .nav a:hover {
    color: var(--paprika);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  .top-tools {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .top-tools :global(.ts-ng) {
    --ts-active-bg: var(--ink);
    --ts-border: var(--rule);
  }
  @media (min-width: 62rem) {
    .nav {
      display: flex;
    }
  }
  @media (max-width: 47.99rem) {
    .top .btn-small {
      display: none;
    }
    .logo {
      font-size: 1.35rem;
    }
  }

  /* Hero */
  .hero {
    padding-block: clamp(1.75rem, 5vw, 4.5rem) clamp(2.5rem, 6vw, 5rem);
  }
  .hero-grid {
    display: grid;
    gap: 2.25rem;
    align-items: center;
  }
  @media (min-width: 60rem) {
    .hero-grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 4rem;
    }
  }
  .hero-copy :global(.hero-oh) {
    --oh-badge-bg: var(--paper);
  }
  .hero h1 {
    margin-top: 1.1rem;
    font-size: clamp(2.7rem, 1.4rem + 5.4vw, 5.6rem);
  }
  .hero h1 em {
    display: block;
  }
  .lede {
    max-width: 30rem;
    margin-top: 1.25rem;
    font-size: clamp(1.2rem, 1.1rem + 0.4vw, 1.4rem);
    color: var(--ink);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  @media (max-width: 30rem) {
    .actions .btn {
      width: 100%;
    }
  }
  .hero-media {
    position: relative;
    padding: 0.75rem;
    border-radius: 15rem 15rem 1.5rem 1.5rem;
    background: var(--paper);
    box-shadow: 0 0 0 2px var(--paprika), 0 30px 60px -30px rgb(43 29 22 / 0.5);
  }
  .hero-media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 4.2;
    object-fit: cover;
    object-position: 50% 65%;
    border-radius: 14rem 14rem 1rem 1rem;
  }
  .sticker {
    position: absolute;
    left: -0.5rem;
    bottom: 1.75rem;
    display: grid;
    place-content: center;
    width: 8.5rem;
    height: 8.5rem;
    border-radius: 50%;
    background: var(--gold);
    color: var(--ink);
    text-align: center;
    transform: rotate(-8deg);
    box-shadow: 0 14px 30px -12px rgb(43 29 22 / 0.55);
  }
  .sticker span {
    font-size: 0.9rem;
    font-weight: 800;
