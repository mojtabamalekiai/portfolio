---
import { site, external } from '../data/site';
import { getLang } from '../i18n';
import { ui } from '../i18n/ui';
import { getProjects } from '../data/projects';
import Icon from './Icon.astro';
import BrowserFrame from './BrowserFrame.astro';
import PhoneFrame from './PhoneFrame.astro';

const lang = getLang(Astro.url);
const t = ui[lang];
const [morzsa, north, ledger] = getProjects(lang);
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 id="hero-title">{t.hero.title} <em>{t.hero.titleEm}</em></h1>
      <p class="lede">{t.hero.lede}</p>
      <div class="actions">
        <a href={site.facebook} class="btn btn--primary btn--lg" {...external}>
          <Icon name="messenger" />
          {t.hero.cta}
          <span class="visually-hidden">{t.newTab}</span>
        </a>
        <a href="#work" class="btn btn--ghost btn--lg">
          {t.hero.secondary}
          <Icon name="arrow-down" />
        </a>
      </div>
      <ul class="perks">
        {
          t.hero.perks.map((p) => (
            <li>
              <Icon name="check" />
              {p}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="showcase" role="group" aria-label={t.hero.showcase}>
      <BrowserFrame
        class="win win-back"
        src={north.desktop}
        alt={north.alt}
        label={`${t.work.concept} · ${north.name}`}
        sizes="(min-width: 70rem) 34vw, 72vw"
        eager
      />
      <BrowserFrame
        class="win win-front"
        src={morzsa.desktop}
        alt={morzsa.alt}
        label={`${t.work.concept} · ${morzsa.name}`}
        sizes="(min-width: 70rem) 38vw, 80vw"
        eager
      />
      <PhoneFrame class="win win-phone" src={ledger.mobile} alt={ledger.alt} sizes="(min-width: 70rem) 10rem, 24vw" eager />
      <p class="showcase-note">
        <span class="pulse" aria-hidden="true"></span>
        {t.hero.note}
        <a href="#work">{t.hero.explore}</a>
      </p>
    </div>
  </div>

  <div class="container audiences">
    <p class="aud-label">{t.audiences.label}</p>
    <ul>
      {t.audiences.items.map((a) => <li>{a}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2rem, 0.5rem + 5vw, 5rem) 0;
  }
  .hero-grid {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 5rem);
    align-items: center;
  }
  @media (min-width: 70rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
      gap: clamp(2.5rem, 4vw, 4.5rem);
    }
  }
  .hero h1 {
    margin-top: var(--space-m);
    font-size: clamp(2.8rem, 1.4rem + 4.6vw, 5.4rem);
    line-height: 1;
    letter-spacing: -0.035em;
    max-width: 13ch;
  }
  .hero h1 em {
    color: var(--accent);
  }
  .lede {
    max-width: 31rem;
    margin-top: var(--space-m);
    color: var(--ink-2);
    font-size: var(--text-lg);
    line-height: 1.55;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-l);
  }
  .perks {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    margin-top: var(--space-m);
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .perks li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .perks :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--accent);
    stroke-width: 2.2;
  }
  @media (max-width: 30rem) {
    .actions .btn {
      width: 100%;
    }
  }

  /* Showcase composition */
  .showcase {
    position: relative;
    aspect-ratio: 1 / 0.82;
    margin-inline: auto;
    width: 100%;
    max-width: 44rem;
  }
  .showcase :global(.win) {
    position: absolute;
  }
  .showcase :global(.win-back) {
    top: 0;
    right: 0;
    width: 74%;
  }
  .showcase :global(.win-front) {
    left: 0;
    bottom: 10%;
    width: 80%;
  }
  .showcase :global(.win-phone) {
    right: 3%;
    bottom: 0;
    width: 23%;
  }
  .showcase-note {
    position: absolute;
    left: 0;
    bottom: -0.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .showcase-note a {
    color: var(--ink);
    font-weight: 600;
  }
  .pulse {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
  }
  @media (max-width: 40rem) {
    .showcase {
      aspect-ratio: 1 / 0.95;
      margin-bottom: 2.5rem;
    }
    .showcase :global(.win-back) {
      width: 86%;
    }
    .showcase :global(.win-front) {
      width: 88%;
      bottom: 14%;
    }
    .showcase :global(.win-phone) {
      width: 30%;
      right: 0;
    }
    .showcase :global(.win .bar) {
      height: 1.5rem;
    }
    .showcase :global(.win .url) {
      font-size: 0.6rem;
    }
    .showcase-note {
      bottom: -2.5rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .showcase :global(.win) {
      animation: rise 900ms var(--ease-out) both;
    }
    .showcase :global(.win-back) {
      animation-delay: 120ms;
    }
    .showcase :global(.win-front) {
      animation-delay: 260ms;
    }
    .showcase :global(.win-phone) {
      animation-delay: 420ms;
    }
    .hero-copy > * {
      animation: fade-up 800ms var(--ease-out) both;
    }
    .hero-copy > :nth-child(2) {
      animation-delay: 60ms;
    }
    .hero-copy > :nth-child(3) {
      animation-delay: 140ms;
    }
    .hero-copy > :nth-child(n + 4) {
      animation-delay: 220ms;
    }
    .pulse {
      animation: pulse 2.4s ease-in-out infinite;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 5px rgb(36 67 219 / 0.15);
    }
  }

  /* Audiences band */
  .audiences {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-xs) var(--space-l);
    margin-top: clamp(3.5rem, 2rem + 5vw, 5.5rem);
    padding-block: var(--space-m);
    border-block: 1px solid var(--line);
  }
  .aud-label {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .audiences ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.6rem;
    padding: 0;
    list-style: none;
  }
  .audiences li {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    white-space: nowrap;
  }
  .audiences li::before {
    content: '';
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
