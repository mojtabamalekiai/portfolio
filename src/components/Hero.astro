---
import { Image } from 'astro:assets';
import { site, external } from '../data/site';
import { getLang } from '../i18n';
import { ui } from '../i18n/ui';
import { getProjects } from '../data/projects';
import { face } from '../data/portrait';
import Icon from './Icon.astro';
import BrowserFrame from './BrowserFrame.astro';
import PhoneFrame from './PhoneFrame.astro';

const lang = getLang(Astro.url);
const t = ui[lang];
const projects = getProjects(lang);
const by = (slug: string) => projects.find((p) => p.slug === slug)!;
const [nagyi, villam, pipacs, kerek] = ['nagyi-konyhaja', 'villam-szerelo', 'pipacs-viragbolt', 'kerek-autoszerviz'].map(by);
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="container hero-grid">
    <div class="hero-copy">
      {
        face && (
          <p class="who">
            <Image src={face} alt="" width={112} height={112} quality={82} class="who-img" loading="eager" />
            <span>
              <strong>Mojtaba (Moji) Maleki</strong>
              <span>{t.hero.role}</span>
            </span>
          </p>
        )
      }
      <h1 id="hero-title">{t.hero.title} <em>{t.hero.titleEm}</em></h1>
      <p class="lede">{t.hero.lede}</p>
        <!-- Phones: three phone screens side by side -->
        <a href="#work" class="trio" aria-label={t.hero.showcase}>
          <PhoneFrame class="p p1" src={villam.mobile} alt="" sizes="30vw" />
          <PhoneFrame class="p p2" src={nagyi.mobile} alt="" sizes="36vw" eager />
          <PhoneFrame class="p p3" src={pipacs.mobile} alt="" sizes="30vw" />
        </a>
      <div class="actions">
        <a href={site.facebook} class="btn btn--primary btn--lg" {...external}>
          <Icon name="messenger" />
          {t.hero.cta}
          <span class="visually-hidden">{t.newTab}</span>
        </a>
        <a href="#work" class="btn btn--ghost btn--lg">
          {t.hero.secondary}
          <Icon name="arrow-down" />
        </a>
      </div>
      <ul class="perks">
        {
          t.hero.perks.map((p) => (
            <li>
              <Icon name="check" />
              {p}
            </li>
          ))
        }
      </ul>
    </div>

    <a href="#work" class="showcase" aria-label={t.hero.showcase} tabindex="-1">
      <!-- Computers: layered browser windows -->
      <div class="desk" aria-hidden="true">
        <BrowserFrame class="win win-back" src={kerek.desktop} alt="" label={kerek.name} sizes="(min-width: 64rem) 34vw, 1px" />
        <BrowserFrame class="win win-front" src={nagyi.desktop} alt="" label={nagyi.name} sizes="(min-width: 64rem) 38vw, 1px" eager />
        <PhoneFrame class="win win-phone" src={pipacs.mobile} alt="" sizes="(min-width: 64rem) 10rem, 1px" />
      </div>

    </a>
  </div>

  <div class="container audiences">
    <p class="aud-label">{t.audiences.label}</p>
    <ul>
      {t.audiences.items.map((a) => <li>{a}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(1.5rem, 0.5rem + 4vw, 4.5rem) 0;
  }
  .hero-grid {
    display: grid;
    gap: clamp(2rem, 1.5rem + 3vw, 4rem);
    align-items: center;
  }
  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: clamp(2.5rem, 4vw, 4.5rem);
    }
  }
  .who {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.35rem 1.1rem 0.35rem 0.35rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--card);
    line-height: 1.25;
  }
  .who :global(.who-img) {
    flex: none;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    object-fit: cover;
  }
  .who > span {
    display: grid;
  }
  .who strong {
    color: var(--ink);
    font-size: 1.0625rem;
    font-weight: 700;
  }
  .who > span > span {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .hero h1 {
    margin-top: var(--space-m);
    font-size: clamp(2.3rem, 1.2rem + 4.4vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .hero h1 em {
    display: block;
    color: var(--accent);
  }
  .lede {
    max-width: 32rem;
    margin-top: var(--space-m);
    color: var(--ink-2);
    font-size: var(--text-lg);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-l);
  }
  @media (max-width: 40rem) {
    .actions .btn {
      width: 100%;
    }
  }
  .perks {
    display: grid;
    gap: 0.45rem;
    margin-top: var(--space-m);
    padding: 0;
    list-style: none;
    color: var(--ink);
    font-weight: 600;
  }
  @media (min-width: 40rem) {
    .perks {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.5rem;
    }
  }
  .perks li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .perks :global(svg) {
    flex: none;
    width: 1.4rem;
    height: 1.4rem;
    padding: 0.2rem;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    stroke-width: 3;
  }

  /* Showcase */
  .showcase {
    display: block;
    color: inherit;
  }
  .showcase:focus-visible {
    outline-offset: 6px;
    border-radius: var(--radius-l);
  }
  .showcase {
    display: none;
  }
  @media (min-width: 64rem) {
    .showcase {
      display: block;
    }
    .desk {
      position: relative;
      aspect-ratio: 1 / 0.8;
    }
    .trio {
      display: none !important;
    }
  }
  .desk :global(.win) {
    position: absolute;
  }
  .desk :global(.win-back) {
    top: 0;
    right: 0;
    width: 74%;
  }
  .desk :global(.win-front) {
    left: 0;
    bottom: 8%;
    width: 80%;
  }
  .desk :global(.win-phone) {
    right: 3%;
    bottom: 0;
    width: 23%;
  }
  .trio {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1fr;
    align-items: center;
    gap: 3%;
    margin-top: var(--space-l);
    padding: 1.5rem 3% 0;
    border-radius: var(--radius-l);
    background:
      radial-gradient(70% 60% at 50% 100%, rgb(36 67 219 / 0.16), transparent 70%),
      var(--paper-2);
    overflow: hidden;
  }
  .trio :global(.p) {
    box-shadow: 0 20px 40px -18px rgb(21 22 26 / 0.45);
  }
  .trio :global(.p1),
  .trio :global(.p3) {
    margin-top: 2.5rem;
  }
  .trio :global(.p2) {
    margin-bottom: -2rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .desk :global(.win),
    .trio :global(.p) {
      animation: rise 700ms var(--ease-out) both;
    }
    .desk :global(.win-front),
    .trio :global(.p2) {
      animation-delay: 120ms;
    }
    .desk :global(.win-phone),
    .trio :global(.p3) {
      animation-delay: 240ms;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  /* Audiences */
  .audiences {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-xs) var(--space-l);
    margin-top: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    padding-block: var(--space-m);
    border-block: 1px solid var(--line);
  }
  .aud-label {
    color: var(--accent-ink);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .audiences ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    padding: 0;
    list-style: none;
  }
  .audiences li {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    white-space: nowrap;
  }
  .audiences li::before {
    content: '';
    width: 0.32rem;
    height: 0.32rem;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
