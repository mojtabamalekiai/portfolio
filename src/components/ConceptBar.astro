---
import { getLang, localePath } from '../i18n';
import LangSwitch from './LangSwitch.astro';

interface Props {
  business: string;
}
const { business } = Astro.props;
const lang = getLang(Astro.url);
const t =
  lang === 'hu'
    ? {
        label: 'Erről az oldalról',
        back: 'Vissza',
        note: `Mintaoldal · a ${business} kitalált vállalkozás`,
        cta: 'Ilyet szeretnék',
      }
    : {
        label: 'About this page',
        back: 'Back',
        note: `Sample website · ${business} is a made-up business`,
        cta: 'I want one like this',
      };
---

<aside class="concept-bar" aria-label={t.label}>
  <a href={localePath(lang, '/#work')} class="back">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.8"></path></svg>
    {t.back}
  </a>
  <p class="note">{t.note}</p>
  <div class="right">
    <a href={localePath(lang, '/#contact')} class="cta">{t.cta}</a>
    <LangSwitch tone="dark" />
  </div>
</aside>

<style>
  .concept-bar {
    position: relative;
    z-index: 60;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 0.45rem clamp(0.75rem, 3vw, 2rem);
    background: #15161a;
    color: #e9e5dc;
    font: 500 0.9375rem/1.3 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    padding: 0 0.9rem 0 0.6rem;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: 999px;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }
  .back:hover {
    background: rgb(255 255 255 / 0.1);
  }
  .back svg {
    width: 1rem;
    height: 1rem;
  }
  .note {
    color: #cfcac0;
    min-width: 0;
  }
  .right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-radius: 999px;
    background: #2443db;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .cta:hover {
    background: #1a32ad;
  }
  .concept-bar :focus-visible {
    outline: 2px solid #8fa2ff;
    outline-offset: 2px;
  }
  @media (max-width: 47.99rem) {
    .concept-bar {
      grid-template-columns: auto 1fr;
    }
    .note {
      grid-column: 1 / -1;
      grid-row: 2;
      font-size: 0.875rem;
      padding-bottom: 0.15rem;
    }
    .right {
      justify-self: end;
    }
    .cta {
      padding: 0 0.85rem;
      font-size: 0.9375rem;
    }
  }
  @media (max-width: 22rem) {
    .cta {
      display: none;
    }
  }
  :global(.shot) .concept-bar {
    display: none;
  }
</style>
