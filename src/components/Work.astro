---
import { Picture } from 'astro:assets';
import { getLang } from '../i18n';
import { ui } from '../i18n/ui';
import { getProjects } from '../data/projects';
import Icon from './Icon.astro';

const lang = getLang(Astro.url);
const t = ui[lang];
const projects = getProjects(lang);
const FIRST = 6;
---

<section id="work" class="section work" aria-labelledby="work-title">
  <div class="container">
    <div class="head" data-reveal>
      <p class="eyebrow">{t.work.eyebrow}</p>
      <h2 id="work-title">{t.work.title}</h2>
      <p class="lede">{t.work.lede}</p>
      <p class="hint">{t.work.hoverHint}</p>
    </div>

    <ul class="cards" data-cards>
      {
        projects.map((p, i) => (
          <li class:list={['card', { 'card--dark': p.dark }]} style={`--tone: ${p.tone}; --stage: ${p.stage}`} data-extra={i >= FIRST ? '' : undefined}>
            <a href={p.href} class="card-link">
              <div class="stage">
                <div class="browser" aria-hidden="true">
                  <div class="bar">
                    <span class="dots">
                      <i />
                      <i />
                      <i />
                    </span>
                    <span class="url">{p.name}</span>
                  </div>
                  <div class="screen">
                    <Picture src={p.preview} alt="" formats={['avif', 'webp']} quality={68} widths={[560, 840, 1100]} sizes="(min-width: 64rem) 30vw, 1px" />
                  </div>
                </div>
                <div class="peek">
                  <Picture src={p.mobile} alt={p.alt} formats={['avif', 'webp']} quality={70} widths={[320, 480, 640]} sizes="(min-width: 64rem) 1px, (min-width: 40rem) 30vw, 60vw" />
                </div>
              </div>
              <div class="info">
                <p class="meta">
                  <span class="tag">{t.work.concept}</span>
                  <span>{p.kind}</span>
                </p>
                <h3>{p.name}</h3>
                <p class="summary">{p.summary}</p>
                <span class="open">
                  {t.work.open}
                  <Icon name="arrow-r" />
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
    {
      projects.length > FIRST && (
        <div class="more-wrap">
          <button type="button" class="btn btn--ghost btn--lg more" data-more hidden data-label-more={t.work.more(projects.length - FIRST)} data-label-less={t.work.less} aria-expanded="false">
            <span data-label>{t.work.more(projects.length - FIRST)}</span>
            <Icon name="arrow-down" />
          </button>
        </div>
      )
    }
  </div>
</section>

<script>
  // Show the first six examples; one big button reveals the rest. Without JavaScript all are visible.
  const btn = document.querySelector<HTMLButtonElement>('[data-more]');
  const extras = [...document.querySelectorAll<HTMLElement>('[data-extra]')];
  if (btn && extras.length) {
    const label = btn.querySelector<HTMLElement>('[data-label]')!;
    let open = false;
    const render = () => {
      extras.forEach((e) => (e.hidden = !open));
      btn.setAttribute('aria-expanded', String(open));
      label.textContent = (open ? btn.dataset.labelLess : btn.dataset.labelMore) ?? '';
      btn.classList.toggle('is-open', open);
    };
    btn.hidden = false;
    render();
    btn.addEventListener('click', () => {
      open = !open;
      render();
      if (open) extras[0].querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
      else document.getElementById('work')?.scrollIntoView({ behavior: 'smooth' });
    });
  }
</script>

<style>
  .head {
    max-width: 44rem;
    margin-bottom: var(--space-xl);
  }
  .head h2 {
    margin-top: var(--space-s);
    font-size: var(--text-3xl);
  }
  .lede {
    margin-top: var(--space-s);
    color: var(--ink-2);
    font-size: var(--text-lg);
  }
  .hint {
    display: none;
    margin-top: var(--space-xs);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  @media (hover: hover) and (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    .hint {
      display: block;
    }
  }

  .cards {
    display: grid;
    gap: clamp(1.25rem, 2vw, 1.75rem);
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .card[hidden] {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .card:not([hidden]) {
      animation: card-in 400ms var(--ease-out) both;
    }
  }
  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-l);
    background: var(--card);
    border: 1px solid var(--line-strong);
    color: inherit;
    text-decoration: none;
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur-slow) var(--ease-out);
  }
  .card-link:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-l);
  }
  .card-link:focus-visible {
    outline-offset: 4px;
    border-radius: var(--radius-l);
  }

  /* Stage */
  .stage {
    position: relative;
    aspect-ratio: 4 / 3;
    background:
      radial-gradient(110% 80% at 100% 100%, color-mix(in srgb, var(--tone) 35%, transparent), transparent 60%),
      var(--stage);
    overflow: hidden;
  }
  /* Phones & tablets: a phone peeking up from the bottom, showing the site at a readable size */
  .peek {
    position: absolute;
    left: 50%;
    top: 9%;
    width: 58%;
    padding: 0.4rem 0.4rem 0;
    border-radius: 1.6rem 1.6rem 0 0;
    background: #15161a;
    transform: translateX(-50%);
    box-shadow: 0 20px 40px -12px rgb(0 0 0 / 0.5);
  }
  .peek :global(img) {
    width: 100%;
    aspect-ratio: 390 / 560;
    object-fit: cover;
    object-position: top;
    border-radius: 1.25rem 1.25rem 0 0;
  }
  .browser {
    display: none;
  }
  /* Computers: a browser window that scrolls through the whole page on hover */
  @media (min-width: 64rem) {
    .peek {
      display: none;
    }
    .browser {
      position: absolute;
      left: 7%;
      right: 7%;
      top: 9%;
      display: block;
      overflow: hidden;
      border-radius: 10px 10px 0 0;
      background: #fbf9f4;
      box-shadow: 0 30px 60px -24px rgb(0 0 0 / 0.5);
    }
  }
  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.6rem;
    height: 1.6rem;
    padding-inline: 0.6rem;
    border-bottom: 1px solid rgb(0 0 0 / 0.07);
    background: #f5f2ec;
  }
  .bar::after {
    content: '';
    width: 1.6rem;
  }
  .dots {
    display: flex;
    gap: 0.25rem;
  }
  .dots i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: #d9d3c7;
  }
  .url {
    justify-self: center;
    padding: 0.05rem 0.7rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.05);
    color: #6d6a62;
    font-size: 0.66rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .screen {
    aspect-ratio: 16 / 10.4;
    overflow: hidden;
  }
  .screen :global(picture),
  .screen :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .screen :global(img) {
    object-fit: cover;
    object-position: 50% 0%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .screen :global(img) {
      transition: object-position 6s cubic-bezier(0.45, 0, 0.4, 1);
    }
    .card-link:hover .screen :global(img),
    .card-link:focus-visible .screen :global(img) {
      object-position: 50% 100%;
    }
  }

  /* Info */
  .info {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.35rem;
    padding: var(--space-m) var(--space-m) var(--space-l);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.65rem;
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .tag {
    padding: 0.1rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--paper-2);
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .info h3 {
    margin-top: 0.25rem;
    font-size: var(--text-2xl);
  }
  .summary {
    color: var(--ink-2);
  }
  .open {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    align-self: flex-start;
    min-height: 3rem;
    margin-top: auto;
    padding: 0.5rem 1.2rem;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--paper);
    font-weight: 700;
    transition: background-color var(--dur) ease;
  }
  .info .summary {
    margin-bottom: var(--space-s);
  }
  .open :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    stroke-width: 2.2;
    transition: transform var(--dur) var(--ease-out);
  }
  .card-link:hover .open,
  .card-link:focus-visible .open {
    background: var(--accent);
  }
  .card-link:hover .open :global(svg) {
    transform: translateX(3px);
  }

  .more-wrap {
    display: flex;
    justify-content: center;
    margin-top: var(--space-xl);
  }
  .more[hidden] {
    display: none;
  }
  .more {
    width: 100%;
    max-width: 26rem;
    border-width: 2px;
    border-color: var(--ink);
  }
  .more :global(svg) {
    transition: transform var(--dur) var(--ease-out);
  }
  .more.is-open :global(svg) {
    transform: rotate(180deg);
  }
</style>
