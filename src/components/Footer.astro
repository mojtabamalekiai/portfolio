---
import { site, external, mailtoHref } from '../data/site';
import { getLang, localePath } from '../i18n';
import { ui } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';

const lang = getLang(Astro.url);
const t = ui[lang];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="brand">
      <a href={localePath(lang, '/')} class="wordmark">Mojtaba Maleki<span aria-hidden="true"></span></a>
      <p>{t.footer.tagline}</p>
      <LangSwitch />
    </div>
    <nav aria-label={t.footer.explore}>
      <h2>{t.footer.explore}</h2>
      <ul>
        {
          t.nav.items.map((item) => (
            <li>
              <a href={localePath(lang, `/#${item.id}`)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div>
      <h2>{t.footer.contact}</h2>
      <ul>
        <li><a href={site.facebook} {...external}>Facebook Messenger<span class="visually-hidden"> {t.newTab}</span></a></li>
        <li><a href={mailtoHref(t.contact.subject)} class="email">{site.email}</a></li>
      </ul>
    </div>
  </div>
  <div class="container bottom">
    <p>© <span data-year>{year}</span> Mojtaba Maleki</p>
    <a href="#top" class="to-top">{t.footer.top} ↑</a>
  </div>
</footer>

<script>
  document.querySelectorAll('[data-year]').forEach((el) => {
    el.textContent = String(new Date().getFullYear());
  });
</script>

<style>
  .site-footer {
    padding-block: var(--space-2xl) var(--space-l);
    background: var(--paper);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .footer-grid {
    display: grid;
    gap: var(--space-xl);
  }
  @media (min-width: 40rem) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 64rem) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1.3fr;
    }
    .brand {
      grid-column: auto;
    }
  }
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.15rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.6rem;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .wordmark span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .brand p {
    max-width: 22rem;
    margin-block: var(--space-s) var(--space-m);
  }
  h2 {
    margin-bottom: var(--space-s);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  ul {
    display: grid;
    gap: 0.4rem;
    padding: 0;
    list-style: none;
  }
  ul a,
  .to-top {
    color: var(--ink-2);
    text-decoration: none;
  }
  ul a:hover,
  .to-top:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-s);
    margin-top: var(--space-2xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
  }
</style>
