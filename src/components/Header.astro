---
// No hidden "hamburger" menu: on phones the page is one simple scroll, and the
// contact buttons live in the always-visible bottom bar (see MobileBar).
import { site, external } from '../data/site';
import { getLang, localePath } from '../i18n';
import { ui } from '../i18n/ui';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';

const lang = getLang(Astro.url);
const t = ui[lang];
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a href={localePath(lang, '/')} class="wordmark" aria-label={`${site.name}, ${t.nav.home}`}>
      Mojtaba Maleki<span class="dot" aria-hidden="true"></span>
    </a>
    <nav class="nav" aria-label={t.nav.main}>
      <ul>
        {
          t.nav.items.map((item) => (
            <li>
              <a href={localePath(lang, `/#${item.id}`)} data-spy={item.id}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="tools">
      <LangSwitch />
      <a href={site.facebook} class="btn btn--primary header-cta" {...external}>
        <Icon name="messenger" />
        {t.nav.cta}
        <span class="visually-hidden">{t.newTab}</span>
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
  // Highlight the section currently in view.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
  const sections = links.map((a) => document.getElementById(a.dataset.spy!)).filter((s): s is HTMLElement => Boolean(s));
  if (sections.length && 'IntersectionObserver' in window) {
    const visible = new Map<string, boolean>();
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => visible.set(e.target.id, e.isIntersecting));
        const current = sections.find((s) => visible.get(s.id))?.id;
        links.forEach((a) => (a.dataset.spy === current ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')));
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) ease;
  }
  .site-header[data-scrolled] {
    border-bottom-color: var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    min-height: var(--header-h);
  }
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.15rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }
  .dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .nav {
    display: none;
  }
  .nav ul {
    display: flex;
    gap: var(--space-l);
    padding: 0;
    list-style: none;
  }
  .nav a {
    position: relative;
    color: var(--ink);
    font-size: 1.0625rem;
    font-weight: 600;
    text-decoration: none;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.35rem;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease-out);
  }
  .nav a:hover::after,
  .nav a:focus-visible::after,
  .nav a[aria-current]::after {
    transform: scaleX(1);
  }
  .nav a[aria-current] {
    color: var(--accent-ink);
  }
  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }
  .header-cta {
    display: none;
    min-height: 3rem;
    padding-block: 0.6rem;
  }
  @media (min-width: 64rem) {
    .nav {
      display: block;
    }
    .header-cta {
      display: inline-flex;
    }
  }
  @media (max-width: 22rem) {
    .wordmark {
      font-size: 1.2rem;
    }
  }
</style>
