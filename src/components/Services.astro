---
import { getLang } from '../i18n';
import { ui } from '../i18n/ui';
import Icon, { type IconName } from './Icon.astro';

const t = ui[getLang(Astro.url)];
---

<section id="services" class="section services" aria-labelledby="services-title">
  <div class="container">
    <div class="head" data-reveal>
      <p class="eyebrow">{t.services.eyebrow}</p>
      <h2 id="services-title">{t.services.title}</h2>
    </div>

    <ul class="grid">
      {
        t.services.items.map((s, i) => (
          <li data-reveal style={`--reveal-delay: ${i}`}>
            <span class="icon-wrap">
              <Icon name={s.icon as IconName} />
            </span>
            <div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="included" data-reveal>
      <p class="inc-label">{t.services.includedLabel}</p>
      <ul>
        {
          t.services.included.map((item) => (
            <li>
              <Icon name="check" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .services {
    padding-top: clamp(3rem, 2rem + 4vw, 6rem);
  }
  .head {
    display: grid;
    gap: var(--space-s);
    margin-bottom: var(--space-xl);
  }
  .head h2 {
    font-size: var(--text-3xl);
  }
  .grid {
    display: grid;
    gap: var(--space-s);
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 72rem) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .grid li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-s);
    padding: var(--space-m);
    border-radius: var(--radius-l);
    border: 1px solid var(--line);
    background: var(--card);
  }
  @media (min-width: 72rem) {
    .grid li {
      flex-direction: column;
      padding: var(--space-l) var(--space-m);
    }
  }
  .icon-wrap {
    display: grid;
    place-items: center;
    flex: none;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .icon-wrap :global(svg) {
    width: 1.45rem;
    height: 1.45rem;
  }
  .grid h3 {
    font-size: var(--text-xl);
    line-height: 1.2;
  }
  .grid p {
    margin-top: 0.25rem;
  }
  .grid p {
    color: var(--ink-2);
  }
  .included {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-l);
    margin-top: var(--space-l);
    padding: var(--space-m) 0;
    border-block: 1px solid var(--line);
  }
  .inc-label {
    color: var(--accent-ink);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .included ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-l);
    padding: 0;
    list-style: none;
  }
  .included li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    font-weight: 600;
  }
  .included :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--accent);
    stroke-width: 2.2;
  }
</style>
