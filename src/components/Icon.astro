---
export type IconName =
  | 'arrow-ur'
  | 'arrow-down'
  | 'arrow-r'
  | 'messenger'
  | 'mail'
  | 'copy'
  | 'check'
  | 'menu'
  | 'close'
  | 'store'
  | 'target'
  | 'portfolio'
  | 'refresh';
type Name = IconName;
interface Props {
  name: Name;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class:list={['icon', `icon-${name}`, className]}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow-ur' && <path d="M7 17 17 7M8 7h9v9" />}
  {name === 'arrow-down' && <path d="M12 5v14M6 13l6 6 6-6" />}
  {name === 'arrow-r' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {
    name === 'messenger' && (
      <>
        <path d="M12 3C7 3 3 6.7 3 11.3c0 2.6 1.3 4.9 3.3 6.4V21l3-1.7c.9.3 1.8.4 2.7.4 5 0 9-3.7 9-8.4S17 3 12 3Z" />
        <path d="m7.5 13.5 3-3.2 2.2 2 3.8-2.8-3 3.2-2.2-2-3.8 2.8Z" fill="currentColor" stroke-width="1" />
      </>
    )
  }
  {
    name === 'mail' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2.5" />
        <path d="m4 7 8 6 8-6" />
      </>
    )
  }
  {
    name === 'copy' && (
      <>
        <rect x="9" y="9" width="11" height="11" rx="2" />
        <path d="M5 15V6a2 2 0 0 1 2-2h8" />
      </>
    )
  }
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === 'menu' && <path d="M4 8h16M4 16h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {
    name === 'store' && (
      <>
        <path d="M4 9.5 5.5 4h13L20 9.5" />
        <path d="M4 9.5a2.7 2.7 0 0 0 5.3 0 2.7 2.7 0 0 0 5.4 0 2.7 2.7 0 0 0 5.3 0" />
        <path d="M5.5 12v8h13v-8M10 20v-5h4v5" />
      </>
    )
  }
  {
    name === 'target' && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <circle cx="12" cy="12" r="4.5" />
        <circle cx="12" cy="12" r="1" fill="currentColor" />
      </>
    )
  }
  {
    name === 'portfolio' && (
      <>
        <rect x="3.5" y="4.5" width="17" height="15" rx="2" />
        <path d="m3.5 16 4.5-4.5 3.5 3.5 3-3 6 6" />
        <circle cx="15.5" cy="9" r="1.5" />
      </>
    )
  }
  {
    name === 'refresh' && (
      <>
        <path d="M19.5 12a7.5 7.5 0 0 1-13.1 5" />
        <path d="M4.5 12a7.5 7.5 0 0 1 13.1-5" />
        <path d="M18 3v4.2h-4.2M6 21v-4.2h4.2" />
      </>
    )
  }
</svg>
