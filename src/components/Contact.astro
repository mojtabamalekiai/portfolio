---
import { site, external, mailtoHref } from '../data/site';
import { getLang } from '../i18n';
import { ui } from '../i18n/ui';
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import { face } from '../data/portrait';

const t = ui[getLang(Astro.url)].contact;
const newTab = ui[getLang(Astro.url)].newTab;
const defaultMessage = `${t.greeting} ${t.defaultNeed} ${t.closing}`;
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="container contact-grid">
    <div class="contact-head" data-reveal>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="contact-title">{t.title} <em>{t.titleEm}</em></h2>
      <p class="intro">{t.lede}</p>
      <p class="personal">
        {face && <Image src={face} alt="" width={96} height={96} quality={82} class="avatar" />}
        <span>{t.personal}</span>
      </p>
      <div class="direct">
        <span>{t.orEmail}</span>
        <a href={mailtoHref(t.subject)} class="email">{site.email}</a>
        <button class="copy" type="button" data-copy={site.email} data-done={t.copiedShort} hidden>
          <Icon name="copy" class="i-copy" />
          <Icon name="check" class="i-done" />
          <span class="copy-label">{t.copy}</span>
        </button>
      </div>
    </div>

    <form
      class="composer"
      data-composer
      data-greeting={t.greeting}
      data-default={t.defaultNeed}
      data-prefix={t.businessPrefix}
      data-closing={t.closing}
      data-subject={t.subject}
      data-copied={t.copied}
      data-fallback={t.copyFallback}
      data-reveal
      style="--reveal-delay: 1"
    >
      <fieldset>
        <legend>{t.needLabel}</legend>
        <div class="chips">
          {
            t.needs.map((n) => (
              <label class="chip">
                <input type="radio" name="need" value={n.id} data-msg={n.msg} />
                <span>{n.label}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <label class="field">
        <span class="label">{t.businessLabel} <em>({t.optional})</em></span>
        <input name="business" type="text" placeholder={t.businessPlaceholder} autocomplete="organization" maxlength="120" />
      </label>

      <label class="field">
        <span class="label">{t.messageLabel} <em>({t.editable})</em></span>
        <textarea name="message" rows="3" maxlength="1000">{defaultMessage}</textarea>
      </label>

      <div class="send">
        <a class="btn btn--primary btn--lg" href={site.facebook} {...external} data-send-messenger>
          <Icon name="messenger" />
          {t.sendMessenger}
          <span class="visually-hidden">{newTab}</span>
        </a>
        <a class="btn btn--ghost btn--lg" href={mailtoHref(t.subject, defaultMessage)} data-send-email>
          <Icon name="mail" />
          {t.sendEmail}
        </a>
      </div>
      <p class="note">{t.note}</p>
      <p class="toast" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-composer]');
  if (form) {
    const d = form.dataset;
    const message = form.querySelector<HTMLTextAreaElement>('textarea[name=message]')!;
    const business = form.querySelector<HTMLInputElement>('input[name=business]')!;
    const email = form.querySelector<HTMLAnchorElement>('[data-send-email]')!;
    const messenger = form.querySelector<HTMLAnchorElement>('[data-send-messenger]')!;
    const toast = form.querySelector<HTMLElement>('.toast')!;
    let edited = false;
    let toastTimer = 0;

    const compose = () => {
      const need = form.querySelector<HTMLInputElement>('input[name=need]:checked')?.dataset.msg ?? d.default;
      const biz = business.value.trim().replace(/[.\s]+$/, '');
      return [d.greeting, need, biz ? `${d.prefix} ${biz}.` : '', d.closing].filter(Boolean).join(' ');
    };
    const syncEmail = () => {
      email.href = `mailto:${email.href.slice(7).split('?')[0]}?subject=${encodeURIComponent(d.subject!)}&body=${encodeURIComponent(message.value)}`;
    };
    const update = () => {
      if (!edited) message.value = compose();
      syncEmail();
    };
    const showToast = (text: string) => {
      toast.textContent = text;
      toast.classList.add('is-on');
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toast.classList.remove('is-on'), 5000);
    };

    form.addEventListener('change', (e) => {
      if ((e.target as HTMLElement).matches('input[name=need]')) update();
    });
    business.addEventListener('input', update);
    message.addEventListener('input', () => {
      edited = message.value.trim() !== '' && message.value !== compose();
      syncEmail();
    });
    form.addEventListener('submit', (e) => e.preventDefault());

    // Messenger can't receive pre-filled text from a profile link, so copy it for pasting.
    messenger.addEventListener('click', () => {
      const text = message.value;
      if (navigator.clipboard?.writeText) {
        navigator.clipboard.writeText(text).then(
          () => showToast(d.copied!),
          () => showToast(d.fallback!),
        );
      } else {
        message.select();
        showToast(d.fallback!);
      }
    });
    update();
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    if (!navigator.clipboard) return;
    btn.hidden = false;
    const label = btn.querySelector('.copy-label')!;
    const original = label.textContent;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        btn.classList.add('is-done');
        label.textContent = btn.dataset.done ?? '';
        setTimeout(() => {
          btn.classList.remove('is-done');
          label.textContent = original;
        }, 2200);
      } catch {
        /* The address stays visible to copy by hand. */
      }
    });
  });
</script>

<style>
  .contact {
    padding-block: var(--section);
    background: var(--accent);
    color: #dfe5ff;
  }
  .contact :global(:focus-visible) {
    outline-color: #fff;
  }
  .contact-grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }
  @media (min-width: 64rem) {
    .contact-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: clamp(3rem, 6vw, 6rem);
    }
  }
  .contact .eyebrow {
    color: #c9d2ff;
  }
  .contact h2 {
    margin-top: var(--space-m);
    color: #fff;
    font-size: var(--text-display);
    line-height: 0.98;
    letter-spacing: -0.035em;
    max-width: 10ch;
  }
  .intro {
    max-width: 28rem;
    margin-top: var(--space-l);
    color: #eef1ff;
    font-size: var(--text-lg);
  }
  .personal {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: var(--space-s);
    font-size: var(--text-sm);
  }
  .personal :global(.avatar) {
    flex: none;
    width: 3rem;
    height: 3rem;
    border: 2px solid rgb(255 255 255 / 0.7);
    border-radius: 50%;
    object-fit: cover;
  }
  .direct {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    margin-top: var(--space-l);
    padding-top: var(--space-m);
    border-top: 1px solid rgb(255 255 255 / 0.25);
    font-size: var(--text-sm);
  }
  .email {
    color: #fff;
    font-weight: 600;
    text-underline-offset: 0.25em;
  }
  .copy {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.25rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: var(--radius-pill);
    background: transparent;
    color: #fff;
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .copy[hidden] {
    display: none;
  }
  .copy:hover {
    background: rgb(255 255 255 / 0.12);
  }
  .copy :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
  }
  .copy :global(.i-done),
  .copy.is-done :global(.i-copy) {
    display: none;
  }
  .copy.is-done :global(.i-done) {
    display: block;
  }

  /* Composer */
  .composer {
    display: grid;
    gap: var(--space-m);
    padding: clamp(1.25rem, 0.75rem + 2vw, 2.25rem);
    border-radius: var(--radius-l);
    background: var(--paper);
    color: var(--ink-2);
    box-shadow: 0 40px 80px -40px rgb(10 20 80 / 0.7);
  }
  .composer :global(:focus-visible) {
    outline-color: var(--accent);
  }
  fieldset {
    min-width: 0;
    padding: 0;
    border: 0;
  }
  legend,
  .label {
    display: block;
    margin-bottom: 0.6rem;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .label em {
    color: var(--muted);
    font-style: normal;
    font-weight: 400;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .chip {
    position: relative;
  }
  .chip input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 2.6rem;
    padding: 0.45rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: var(--card);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 500;
    transition: background-color var(--dur-fast) ease, border-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }
  .chip input:hover + span {
    border-color: var(--ink);
  }
  .chip input:checked + span {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }
  .chip input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .field {
    display: block;
  }
  .field input,
  .field textarea {
    width: 100%;
    padding: 0.8rem 0.95rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-m);
    background: var(--card);
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.5;
    transition: border-color var(--dur-fast) ease, box-shadow var(--dur-fast) ease;
  }
  .field textarea {
    resize: vertical;
    min-height: 6.5rem;
  }
  .field input::placeholder {
    color: #8a887f;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgb(36 67 219 / 0.18);
  }
  .send {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  @media (max-width: 30rem) {
    .send .btn {
      width: 100%;
    }
  }
  .note {
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .toast {
    position: fixed;
    left: 50%;
    bottom: calc(1.25rem + env(safe-area-inset-bottom));
    z-index: 80;
    max-width: calc(100vw - 2rem);
    padding: 0.8rem 1.2rem;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--paper);
    font-size: var(--text-sm);
    font-weight: 500;
    box-shadow: var(--shadow-l);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 12px);
    transition: opacity var(--dur) ease, transform var(--dur) var(--ease-out);
  }
  .toast:empty {
    visibility: hidden;
  }
  .toast.is-on {
    opacity: 1;
    transform: translate(-50%, 0);
  }
</style>
