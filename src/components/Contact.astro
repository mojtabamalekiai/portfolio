---
import { Image } from 'astro:assets';
import { site, external, mailtoHref } from '../data/site';
import { getLang } from '../i18n';
import { ui } from '../i18n/ui';
import { face } from '../data/portrait';
import Icon from './Icon.astro';

const t = ui[getLang(Astro.url)];
const c = t.contact;
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="container contact-grid">
    <div class="contact-head" data-reveal>
      <p class="eyebrow">{c.eyebrow}</p>
      <h2 id="contact-title">{c.title} <em>{c.titleEm}</em></h2>
      <p class="intro">{c.lede}</p>
      <figure class="example">
        <figcaption>{c.example}</figcaption>
        <blockquote class="bubble">{c.exampleMsg}</blockquote>
      </figure>
    </div>

    <div class="channels" data-reveal style="--reveal-delay: 1">
      {
        face && (
          <p class="me">
            <Image src={face} alt="" width={120} height={120} quality={82} class="me-img" />
            <span>{c.personal}</span>
          </p>
        )
      }
      <a class="big-btn big-btn--fb" href={site.facebook} {...external}>
        <Icon name="messenger" />
        <span>{t.messenger}</span>
        <span class="visually-hidden">{t.newTab}</span>
      </a>
      <a class="big-btn big-btn--mail" href={mailtoHref(c.subject, c.exampleMsg)}>
        <Icon name="mail" />
        <span>{t.email}</span>
      </a>
      <div class="address">
        <span class="addr-label">{c.orEmail}</span>
        <span class="addr-row">
          <a href={mailtoHref(c.subject)} class="email">{site.email}</a>
          <button class="copy" type="button" data-copy={site.email} data-done={c.copiedShort} hidden>
            <Icon name="copy" class="i-copy" />
            <Icon name="check" class="i-done" />
            <span class="copy-label">{c.copy}</span>
          </button>
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    if (!navigator.clipboard) return;
    btn.hidden = false;
    const label = btn.querySelector('.copy-label')!;
    const original = label.textContent;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        btn.classList.add('is-done');
        label.textContent = btn.dataset.done ?? '';
        setTimeout(() => {
          btn.classList.remove('is-done');
          label.textContent = original;
        }, 2200);
      } catch {
        /* The address stays visible to copy by hand. */
      }
    });
  });
</script>

<style>
  .contact {
    padding-block: var(--section);
    background: var(--accent);
    color: #e3e8ff;
  }
  .contact :global(:focus-visible) {
    outline-color: #fff;
  }
  .contact-grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }
  @media (min-width: 64rem) {
    .contact-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: clamp(3rem, 6vw, 6rem);
    }
  }
  .contact .eyebrow {
    color: #d3daff;
  }
  .contact h2 {
    margin-top: var(--space-s);
    color: #fff;
    font-size: var(--text-display);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .contact h2 em {
    display: block;
    color: #ffd84d;
  }
  .intro {
    max-width: 30rem;
    margin-top: var(--space-m);
    color: #fff;
    font-size: var(--text-lg);
  }
  .example {
    max-width: 30rem;
    margin: var(--space-l) 0 0;
  }
  .example figcaption {
    color: #d3daff;
    font-weight: 600;
  }
  .bubble {
    position: relative;
    margin: 0.6rem 0 0;
    padding: 1rem 1.25rem;
    border-radius: 1.25rem 1.25rem 1.25rem 0.3rem;
    background: #fff;
    color: var(--ink);
    font-size: 1.125rem;
    font-weight: 500;
    box-shadow: 0 16px 30px -16px rgb(10 20 80 / 0.6);
  }

  .channels {
    display: grid;
    gap: var(--space-s);
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    border-radius: var(--radius-l);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 40px 80px -40px rgb(10 20 80 / 0.7);
  }
  .me {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: var(--space-2xs);
    font-weight: 600;
  }
  .me :global(.me-img) {
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    object-fit: cover;
  }
  .big-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 4.25rem;
    padding: 0.9rem 1.25rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius-pill);
    color: var(--ink);
    font-size: clamp(1.125rem, 1.05rem + 0.3vw, 1.3rem);
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    transition: transform var(--dur-fast) var(--ease-out), background-color var(--dur-fast) ease;
  }
  .big-btn:hover {
    transform: translateY(-2px);
  }
  .big-btn :global(svg) {
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    stroke-width: 2;
  }
  .big-btn--fb {
    border-color: var(--accent);
    background: var(--accent);
    color: #fff;
  }
  .big-btn--fb:hover {
    background: var(--accent-ink);
  }
  .big-btn--mail:hover {
    background: var(--paper-2);
  }
  .channels :global(:focus-visible) {
    outline-color: var(--accent);
  }
  .address {
    display: grid;
    gap: 0.35rem;
    margin-top: var(--space-2xs);
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
  }
  .addr-label {
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 600;
  }
  .addr-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }
  .email {
    color: var(--ink);
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .copy {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.6rem;
    padding: 0.3rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 700;
  }
  .copy[hidden] {
    display: none;
  }
  .copy:hover {
    border-color: var(--ink);
  }
  .copy :global(svg) {
    width: 1rem;
    height: 1rem;
  }
  .copy :global(.i-done),
  .copy.is-done :global(.i-copy) {
    display: none;
  }
  .copy.is-done :global(.i-done) {
    display: block;
    color: #1f8a4c;
  }
</style>
