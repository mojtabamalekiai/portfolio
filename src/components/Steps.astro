---
import { getLang } from '../i18n';
import { ui } from '../i18n/ui';

const t = ui[getLang(Astro.url)];
---

<section id="process" class="section steps-section" aria-labelledby="process-title">
  <div class="container">
    <p class="eyebrow">{t.steps.eyebrow}</p>
    <h2 id="process-title">{t.steps.title}</h2>
    <ol class="steps">
      {
        t.steps.items.map((s, i) => (
          <li data-reveal style={`--reveal-delay: ${i}`}>
            <span class="num" aria-hidden="true">
              {i + 1}
            </span>
            <div>
              <h3>
                <span class="visually-hidden">{i + 1}. </span>
                {s.title}
              </h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps-section {
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem);
    background: var(--card);
    border-block: 1px solid var(--line);
  }
  h2 {
    margin-top: var(--space-s);
    font-size: var(--text-3xl);
  }
  .steps {
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-xl);
    padding: 0;
    list-style: none;
  }
  @media (min-width: 52rem) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-l);
    }
  }
  .steps li {
    display: flex;
    gap: var(--space-m);
    align-items: flex-start;
  }
  .num {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1;
  }
  .steps h3 {
    font-size: var(--text-xl);
    line-height: 1.2;
  }
  .steps p {
    margin-top: 0.3rem;
    color: var(--ink-2);
  }
</style>
