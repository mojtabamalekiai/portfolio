---
import { site, external } from '../data/site';
import { getLang } from '../i18n';
import { ui } from '../i18n/ui';
import Icon from './Icon.astro';

const t = ui[getLang(Astro.url)];
---

<section id="process" class="section steps-section" aria-labelledby="process-title">
  <div class="container">
    <div class="head" data-reveal>
      <p class="eyebrow">{t.steps.eyebrow}</p>
      <h2 id="process-title">{t.steps.title}</h2>
    </div>
    <ol class="steps">
      {
        t.steps.items.map((s, i) => (
          <li data-reveal style={`--reveal-delay: ${i}`}>
            <span class="num" aria-hidden="true">
              {i + 1}
            </span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
    <div class="cta" data-reveal style="--reveal-delay: 3">
      <a href={site.facebook} class="btn btn--primary" {...external}>
        <Icon name="messenger" />
        {t.steps.cta}
        <span class="visually-hidden">{t.newTab}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .steps-section {
    padding-block: clamp(4.5rem, 3rem + 5vw, 7.5rem);
  }
  .head {
    display: grid;
    gap: var(--space-s);
    margin-bottom: var(--space-xl);
  }
  .head h2 {
    font-size: var(--text-3xl);
    max-width: 16ch;
  }
  .steps {
    display: grid;
    gap: var(--space-m);
    padding: 0;
    list-style: none;
  }
  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-l);
    }
  }
  .steps li {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-s);
    align-items: baseline;
    padding: var(--space-l);
    border-radius: var(--radius-l);
    background: var(--card);
    border: 1px solid var(--line);
  }
  @media (min-width: 48rem) {
    .steps li {
      grid-template-columns: 1fr;
    }
    /* Arrow connecting the cards */
    .steps li:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 50%;
      right: calc(-1 * var(--space-l) / 2 - 0.45rem);
      z-index: 1;
      width: 0.9rem;
      height: 0.9rem;
      border-top: 1.5px solid var(--accent);
      border-right: 1.5px solid var(--accent);
      transform: translateY(-50%) rotate(45deg);
    }
  }
  .num {
    grid-row: span 2;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 2rem + 2vw, 3.75rem);
    font-style: italic;
    font-weight: 300;
    line-height: 0.9;
  }
  @media (min-width: 48rem) {
    .num {
      grid-row: auto;
      margin-bottom: var(--space-m);
    }
  }
  .steps h3 {
    font-size: var(--text-xl);
    line-height: 1.15;
  }
  .steps p {
    margin-top: 0.35rem;
    color: var(--ink-2);
  }
  .cta {
    margin-top: var(--space-l);
  }
</style>
